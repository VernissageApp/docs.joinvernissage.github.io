{"metadata":{"modules":[{"name":"Vernissage"}],"title":"grantTypes","symbolKind":"property","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grantTypes","kind":"identifier"},{"text":": [","kind":"text"},{"text":"OAuthGrantTypeDto","preciseIdentifier":"s:16VernissageServer17OAuthGrantTypeDtoO","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"externalID":"s:16VernissageServer30RegisterOAuthClientResponseDtoV10grantTypesSayAA0d9GrantTypeG0OGvp","roleHeading":"Instance Property"},"sections":[],"kind":"symbol","primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grantTypes","kind":"identifier"},{"text":": [","kind":"text"},{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthGrantTypeDto","text":"OAuthGrantTypeDto","preciseIdentifier":"s:16VernissageServer17OAuthGrantTypeDtoO","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"“authorization_code”: The authorization code grant type defined","type":"text"},{"text":" ","type":"text"},{"text":"in OAuth 2.0, Section 4.1.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"“implicit”: The implicit grant type defined in OAuth 2.0,","type":"text"},{"text":" ","type":"text"},{"text":"Section 4.2.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"“password”: The resource owner password credentials grant type","type":"text"},{"text":" ","type":"text"},{"text":"defined in OAuth 2.0, Section 4.3.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"“client_credentials”: The client credentials grant type defined","type":"text"},{"text":" ","type":"text"},{"text":"in OAuth 2.0, Section 4.4.