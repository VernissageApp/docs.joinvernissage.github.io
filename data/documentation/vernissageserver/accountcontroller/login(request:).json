":"accessToken"},{"type":"text","text":" before it expires."},{"type":"text","text":" "},{"type":"text","text":"The default expiration time for "},{"type":"codeVoice","code":"accessToken"},{"type":"text","text":" is 1 hour. The expiration time of "},{"type":"codeVoice","code":"refreshToken"},{"type":"text","text":" is 30 days."}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Endpoint URL: ","type":"text"},{"code":"\/api\/v1\/account\/login","type":"codeVoice"},{"text":".","type":"text"}]}],"style":"important"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"CURL request:","type":"text"}]}]},{"type":"codeListing","code":["curl \"https:\/\/example.com\/api\/v1\/account\/login\" \\","-X POST \\","-H \"Content-Type: application\/json\" \\","-d '{ ... }'"],"syntax":"bash"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example request body:","type":"text"}]}]},{"type":"codeListing","code":["{","    \"userNameOrEmail\": \"johndoe\",","    \"password\": \"P@ssword1!\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Example response body:","type":"text"}]}]},{"type":"codeListing","code":["{","    \"accessToken\": \"eyJhbGciOiJSUzUxMiIsInR5cCI6IkpXVCJ9.eyJyb2xlcyI6W10sInVzZXJOYW1lIjoibmlja2Z...\",","    \"refreshToken\": \"8v4JbrTeboHsD5T24WdhkkHgVx3UQ2F2FQaZd3sT0\"","}"],"syntax":"json"},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"LoginError.invalidLoginCredentials","type":"codeVoice"},{"text":" if given user name or password are invalid.","type":"text"}]}],"style":"note"},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"LoginError.userAccountIsBlocked","type":"codeVoice"},{"text":" if user account is blocked. User cannot login to the system right now.","type":"text"}]}],"sty