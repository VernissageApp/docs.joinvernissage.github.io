 ","type":"text"},{"text":"encryption.  For instance, these keys might be used by some","type":"text"},{"text":" ","type":"text"},{"text":"applications for validating signed requests made to the token","type":"text"},{"text":" ","type":"text"},{"text":"endpoint when using JWTs for client authentication [RFC7523].  Use","type":"text"},{"text":" ","type":"text"},{"text":"of this parameter is preferred over the “jwks” parameter, as it","type":"text"},{"text":" ","type":"text"},{"text":"allows for easier key rotation.  The “jwks_uri” and “jwks”","type":"text"},{"text":" ","type":"text"},{"text":"parameters MUST NOT both be present in the same request or","type":"text"},{"text":" ","type":"text"},{"text":"response.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwksUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"jwksUri","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwksUri","role":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/jwksuri"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/policyUri":{"title":"policyUri","role":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/policyuri","abstract":[{"text":"URL string that points to a human-readable privacy policy document","type":"text"},{"text":" ","type":"text"},{"text":"that describes how the deployment organization collects, uses,","type":"text"},{"text":" ","type":"text"},{"text":"retains, and discloses personal data.  The authorization server","type":"text"},{"text":" ","type":"text"},{"text":"SHOULD display this URL to the end-user if it is provided.  The","type":"text"},{"text":" ","type":"text"},{"text":"value of this field MUST point to a valid web page.  The value of","type":"text"},{"text":" ","type":"text"},{"text":"this field MAY be internationalized, as described in Section 2.2.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/policyUri","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"policyUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://VernissageServer/Se":{"identifier":"doc:\/\/VernissageServer\/Se","title":"Swift.Decodable","type":"unresolvable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientUri":{"title":"clientUri","abstract":[{"text":"URL string of a web page providing information about the client.","type":"text"},{"text":" ","type":"text"},{"text":"If present, the server SHOULD display this URL to the end-user in","type":"text"},{"text":" ","type":"text"},{"text":"a clickable fashion.  It is RECOMMENDED that clients always send","type":"text"},{"text":" ","type":"text"},{"text":"this field.  The value of this field MUST point to a valid web","type":"text"},{"text":" ","type":"text"},{"text":"page.  The value of this field MAY be internationalized, as","type":"text"},{"text":" ","type":"text"},{"text":"described in Section 2.2.","type":"text"}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clienturi","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clientUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientUri","role":"symbol","kind":"symbol","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/AccessTokenDto":{"role":"symbol","url":"\/documentation\/vernissageserver\/accesstoke