t":"ActivityPubRequestDto"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestDto"},"doc://VernissageServer/documentation/VernissageServer/AttachmentDescriptionDto":{"navigatorTitle":[{"text":"AttachmentDescriptionDto","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/vernissageserver\/attachmentdescriptiondto","abstract":[],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AttachmentDescriptionDto","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AttachmentDescriptionDto","kind":"identifier"}],"title":"AttachmentDescriptionDto"},"doc://VernissageServer/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/s9EscapableP","title":"Swift.Escapable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/grantTypes":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/granttypes","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/grantTypes","abstract":[{"type":"text","text":"Array of OAuth 2.0 grant type strings that the client can use at"},{"type":"text","text":" "},{"type":"text","text":"the token endpoint.  These grant types are defined as follows:"}],"role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"grantTypes","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:16VernissageServer17OAuthGrantTypeDtoO","text":"OAuthGrantTypeDto","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"grantTypes","kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/jwksUri":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/jwksuri","role":"symbol","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwksUri","abstract":[{"type":"text","text":"URL string referencing the client’s JSON Web Key (JWK) Set"},{"type":"text","text":" "},{"type":"text","text":"[RFC7517] document, which contains the client’s public keys.  The"},{"type":"text","text":" "},{"type":"text","text":"value of this field MUST point to a valid JWK Set document.  These"},{"type":"text","text":" "},{"type":"text","text":"keys can be used by higher-level protocols that use signing or"},{"type":"text","text":" "},{"type":"text","text":"encryption.  For instance, these keys might be used by some"},{"type":"text","text":" "},{"type":"text","text":"applications for validating signed requests made to the token"},{"type":"text","text":" "},{"type":"text","text":"endpoint when using JWTs for client authentication [RFC7523].  Use"},{"type":"text","text":" "},{"type":"text","text":"of this parameter is preferred over the “jwks” parameter, as it"},{"type":"text","text":" "},{"type":"text","text":"allows for easier key rotation.  The “jwks_uri” and “jwks”"},{"type":"text","text":" "},{"type":"text","text":"parameters MUST NOT both be present in the same request or"},{"type":"text","text":" "},{"type":"text","text":"response."}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwksUri","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","title":"jwksUri"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareVersion":{"title":"softwareVersion","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareVersion","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareVersion","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareversion","abstract":[{"text":"A version identifier string for the client software identified by","type":"text"},{"text":" ","type":"text"},{"text":"“software_id”.  The value of the “software_version” SHOULD change","type":"text"},{"text":" ","type":"text"},{"text":"on any update to the client software identified by the same","type":"text"},{"text":" ","type":"text"},{"text":"“software_id”.  The value of this field is intended to be compared","type":"text"},{"text":" ","type":"text"},{"text":"using string equality matching and no other comparison semantics","type":"text"},{"text":" ","type":"text"},{"text":"are defined by this specification.  The value of this field is","type":"text"},{"text":" ","type":"text"},{"text":"outside the scope of this specification, but it is not intended to","type":"text"},{"text":" ","type":"text"},{"text":"be human readable and is usually opaque to the client and","type":"text"},{"text":" ","type":"text"},{"text":"authorization server.  The definition of what constitutes an","type":"text"},{"text":" ","type":"text"},{"text":"update to client software that would trigger a change to this","type":"text"},{"text":" ","type":"text"},{"text":"value is specific to the software itself and is outside the scope","type":"text"},{"text":" ","type":"text"},{"text":"of this specification.","type":"text"}],"kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/ArchiveDto":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveDto","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"ArchiveDto","kind":"identifier"}],"url":"\/documentation\/vernissageserver\/archivedto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArchiveDto","kind":"identifier"}],"abstract":[],"title":"ArchiveDto","type":"topic"},"doc://VernissageServer/5Vapor17ResponseEncodableP":{"title":"Vapor.ResponseEncodable","type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor17ResponseEncodableP"},"doc://VernissageServer/5Vapor11ValidatableP":{"type":"unresolvable","title":"Vapor.Validatable","identifier":"doc:\/\/VernissageServer\/5Vapor11ValidatableP"},"doc://VernissageServer/documentation/VernissageServer/ArticleDto":{"abstract":[],"type":"topic","navigatorTitle":[{"text":"ArticleDto","kind":"identifier"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleDto","url":"\/documentation\/vernissageserver\/articledto","title":"ArticleDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticleDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","kind":"symbol","title":"Vernissage","role":"collection","url":"\/documentation\/vernissageserver","type":"topic","abstract":[{"type":"text","text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across"},{"type":"text","text":" "},{"type":"text","text":"the fediverse - offering powerful features you won’t find anywhere else."}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto":{"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegisterOAuthClientRequestDto"}],"kind":"symbol","abstract":[{"text":"OAuth dynamic client registration metadata (RFC 7591).","type":"text"}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto","navigatorTitle":[{"kind":"identifier","text":"RegisterOAuthClientRequestDto"}],"role":"symbol","title":"RegisterOAuthClientRequestDto"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/RequestDecodable-Implementations":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/RequestDecodable-Implementations","kind":"article","abstract":[],"title":"RequestDecodable Implementations","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/requestdecodable-implementations","type":"topic","role":"collectionGroup"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/redirectUris":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/redirecturis","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/redirectUris","abstract":[{"type":"text","text":"Array of redirection URI strings for use in redirect-based flows"},{"type":"text","text":" "},{"type":"text","text":"such as the authorization code and implicit flows.  As required by"},{"type":"text","text":" "},{"type":"text","text":"Section 2 of OAuth 2.0 [RFC6749], clients using flows with"},{"type":"text","text":" "},{"type":"text","text":"redirection MUST register their redirection URI values."},{"type":"text","text":" "},{"type":"text","text":"Authorization servers that support dynamic registration for"},{"type":"text","text":" "},{"type":"text","text":"redirect-based flows MUST implement support for this metadata"},{"type":"text","text":" "},{"type":"text","text":"value."}],"type":"topic","role":"symbol","title":"redirectUris","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"redirectUris","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientName":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientName","kind":"symbol","abstract":[{"text":"Human-readable string name of the client to be presented to the","type":"text"},{"text":" ","type":"text"},{"text":"end-user during authorization.  If omitted, the authorization","type":"text"},{"type":"text","text":" "},{"type":"text","text":"server MAY display the raw “client_id” value to the end-user"},{"type":"text","text":" "},{"type":"text","text":"instead.  It is RECOMMENDED that clients always send this field."},{"type":"text","text":" "},{"type":"text","text":"The value of this field MAY be internationalized, as described in"},{"type":"text","text":" "},{"type":"text","text":"Section 2.2."}],"type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clientname","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"clientName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"title":"clientName"},"doc://VernissageServer/documentation/VernissageServer/AuthClientDto":{"abstract":[],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"AuthClientDto"}],"url":"\/documentation\/vernissageserver\/authclientdto","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AuthClientDto"}],"type":"topic","title":"AuthClientDto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AuthClientDto"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/scope":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/scope","abstract":[{"type":"text","text":"String containing a space-separated list of scope values (as"},{"type":"text","text":" "},{"type":"text","text":"described in Section 3.3 of OAuth 2.0 [RFC6749]) that the client"},{"type":"text","text":" "},{"type":"text","text":"can use when requesting access tokens.  The semantics of values in"},{"type":"text","text":" "},{"type":"text","text":"this list are service specific.  If omitted, an authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY register a client with a default set of scopes."}],"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/scope","role":"symbol","kind":"symbol","title":"scope"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/ResponseEncodable-Implementations":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/ResponseEncodable-Implementations","kind":"article","abstract":[],"title":"ResponseEncodable Implementations","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/responseencodable-implementations","type":"topic","role":"collectionGroup"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/policyUri":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/policyUri","kind":"symbol","abstract":[{"text":"URL string that points to a human-readable privacy policy document","type":"text"},{"text":" ","type":"text"},{"text":"that describes how the deployment organization collects, uses,","type":"text"},{"text":" ","type":"text"},{"text":"retains, and discloses personal data.  The authorization server","type":"text"},{"text":" ","type":"text"},{"text":"SHOULD display this URL to the end-user if it is provided.  The","type":"text"},{"text":" ","type":"text"},{"text":"value of this field MUST point to a valid web page.  The value of","type":"text"},{"text":" ","type":"text"},{"text":"this field MAY be internationalized, as described in Section 2.2.","type":"text"}],"type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/policyuri","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"policyUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"title":"policyUri"},"doc://VernissageServer/SE":{"type":"unresolvable","title":"Swift.Encodable","identifier":"doc:\/\/VernissageServer\/SE"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubUnreblogDto":{"abstract":[],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubUnreblogDto","kind":"identifier"}],"title":"ActivityPubUnreblogDto","url":"\/documentation\/vernissageserver\/activitypubunreblogdto","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"ActivityPubUnreblogDto","kind":"identifier"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubUnreblogDto"},"doc://VernissageServer/5Vapor22AsyncResponseEncodableP":{"identifier":"doc:\/\/VernissageServer\/5Vapor22AsyncResponseEncodableP","type":"unresolvable","title":"Vapor.AsyncResponseEncodable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/Validatable-Implementations":{"kind":"article","title":"Validatable Implementations","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Validatable-Implementations","type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/validatable-implementations","abstract":[],"role":"collectionGroup"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubRequestMethod":{"abstract":[],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubRequestMethod","kind":"identifier"}],"title":"ActivityPubRequestMethod","url":"\/documentation\/vernissageserver\/activitypubrequestmethod","role":"symbol","kind":"symbol","navigatorTitle":[{"text":"ActivityPubRequestMethod","kind":"identifier"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestMethod"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/jwks":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwks","abstract":[{"type":"text","text":"Client’s JSON Web Key Set [RFC7517] document value, which contains"},{"type":"text","text":" "},{"type":"text","text":"the client’s public keys.  The value of this field MUST be a JSON"},{"type":"text","text":" "},{"type":"text","text":"object containing a valid JWK Set.  These keys can be used by"},{"type":"text","text":" "},{"type":"text","text":"higher-level protocols that use signing or encryption.  This"},{"type":"text","text":" "},{"type":"text","text":"parameter is intended to be used by clients that cannot use the"},{"type":"text","text":" "},{"type":"text","text":"“jwks_uri” parameter, such as native clients that cannot host"},{"type":"text","text":" "},{"type":"text","text":"public URLs.  The “jwks_uri” and “jwks” parameters MUST NOT both"},{"type":"text","text":" "},{"type":"text","text":"be present in the same request or response."}],"role":"symbol","type":"topic","title":"jwks","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/jwks","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"jwks"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}],"kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/responseTypes":{"kind":"symbol","role":"symbol","title":"responseTypes","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/responsetypes","identifier":"doc:\/\/VernissageServer\/documentatio