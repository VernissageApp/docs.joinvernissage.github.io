{"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegisterOAuthClientRequestDto","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Registered clients have a set of metadata values associated with","type":"text"},{"text":" ","type":"text"},{"text":"their client identifier at an authorization server, such as the list","type":"text"},{"text":" ","type":"text"},{"text":"of valid redirection URIs or a display name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"These client metadata values are used in two ways:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"as input values to registration requests, and","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"as output values in registration responses.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The following client metadata fields are defined by this","type":"text"},{"text":" ","type":"text"},{"text":"specification.  The implementation and use of all client metadata","type":"text"},{"text":" ","type":"text"},{"text":"fields is OPTIONAL, unless stated otherwise.  All data member types","type":"text"},{"text":" ","type":"text"},{"text":"(strings, arrays, numbers) are defined in terms of their JSON","type":"text"},{"text":" ","type":"text"},{"text":"[RFC7159] representations.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"OAuth dynamic client registration metadata (RFC 7591).","type":"text"}],"seeAlsoSections":[{"title":"Data Transfer Objects","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/AccessTokenDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubFollowRequestDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubFollowRespondDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubReblogDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestMethod","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestPath","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubStatusJobDataDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubUnreblogDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/AttachmentDescriptionDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfoDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleVisibilityDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveDto","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveStatusDto"],"anchor":"Data-Transfer-Objects"}],"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"symbolKind":"struct","modules":[{"name":"Vernissage"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RegisterOAuthClientRequestDto","kind":"identifier"}],"navigatorTitle":[{"text":"RegisterOAuthClientRequestDto","kind":"identifier"}],"role":"symbol","externalID":"s:16VernissageServer29RegisterOAuthClientRequestDtoV","title":"RegisterOAuthClientRequestDto","roleHeading":"Structure"},"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/VernissageServer\/s8CopyableP","doc:\/\/VernissageServer\/Se","doc:\/\/VernissageServer\/SE","doc:\/\/VernissageServer\/s9EscapableP","doc:\/\/VernissageServer\/s8SendableP","doc:\/\/VernissageServer\/s16SendableMetatypeP","doc:\/\/VernissageServer\/5Vapor21AsyncRequestDecodableP","doc:\/\/VernissageServer\/5Vapor22AsyncResponseEncodableP","doc:\/\/VernissageServer\/5Vapor7ContentP","doc:\/\/VernissageServer\/5Vapor16RequestDecodableP","doc:\/\/VernissageServer\/5Vapor17ResponseEncodableP","doc:\/\/VernissageServer\/5Vapor11ValidatableP"],"kind":"relationships"}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/init(redirectUris:tokenEndpointAuthMethod:grantTypes:responseTypes:clientName:clientUri:logoUri:scope:contacts:tosUri:policyUri:jwksUri:jwks:softwareId:softwareVersion:)"],"anchor":"Initializers"},{"title":"Instance Properties","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientName","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientUri","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/contacts","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/grantTypes","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwks","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwksUri","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/logoUri","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/policyUri","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/redirectUris","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/responseTypes","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/scope","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareId","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareVersion","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/tokenEndpointAuthMethod","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/tosUri"],"anchor":"Instance-Properties"},{"title":"Enumerations","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/CodingKeys"],"anchor":"Enumerations"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/AsyncRequestDecodable-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Content-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Decodable-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/RequestDecodable-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/ResponseEncodable-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Validatable-Implementations"],"anchor":"Default-Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserver\/registeroauthclientrequestdto"]}],"references":{"doc://VernissageServer/documentation/VernissageServer/ArchiveDto":{"title":"ArchiveDto","abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArchiveDto","kind":"identifier"}],"navigatorTitle":[{"text":"ArchiveDto","kind":"identifier"}],"url":"\/documentation\/vernissageserver\/archivedto","type":"topic","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveDto","role":"symbol"},"doc://VernissageServer/5Vapor11ValidatableP":{"title":"Vapor.Validatable","identifier":"doc:\/\/VernissageServer\/5Vapor11ValidatableP","type":"unresolvable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareId":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareid","type":"topic","title":"softwareId","abstract":[{"text":"A unique identifier string (e.g., a Universally Unique Identifier","type":"text"},{"text":" ","type":"text"},{"text":"(UUID)) assigned by the client developer or software publisher","type":"text"},{"text":" ","type":"text"},{"text":"used by registration endpoints to identify the client software to","type":"text"},{"text":" ","type":"text"},{"text":"be dynamically registered.  Unlike “client_id”, which is issued by","type":"text"},{"text":" ","type":"text"},{"text":"the authorization server and SHOULD vary between instances, the","type":"text"},{"text":" ","type":"text"},{"text":"“software_id” SHOULD remain the same for all instances of the","type":"text"},{"text":" ","type":"text"},{"text":"client software.  The “software_id” SHOULD remain the same across","type":"text"},{"text":" ","type":"text"},{"text":"multiple updates or versions of the same piece of software.  The","type":"text"},{"text":" ","type":"text"},{"text":"value of this field is not intended to be human readable and is","type":"text"},{"text":" ","type":"text"},{"text":"usually opaque to the client and authorization server.","type":"text"}],"role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareId","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareId","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/RequestDecodable-Implementations":{"abstract":[],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/requestdecodable-implementations","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/RequestDecodable-Implementations","kind":"article","role":"collectionGroup","title":"RequestDecodable Implementations","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/CodingKeys":{"title":"RegisterOAuthClientRequestDto.CodingKeys","abstract":[],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CodingKeys","kind":"identifier"}],"navigatorTitle":[{"text":"CodingKeys","kind":"identifier"}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/codingkeys","type":"topic","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/CodingKeys","role":"symbol"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubFollowRespondDto":{"url":"\/documentation\/vernissageserver\/activitypubfollowresponddto","type":"topic","title":"ActivityPubFollowRespondDto","abstract":[],"role":"symbol","navigatorTitle":[{"text":"ActivityPubFollowRespondDto","kind":"identifier"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubFollowRespondDto","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubFollowRespondDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer/ArticleDto":{"url":"\/documentation\/vernissageserver\/articledto","title":"ArticleDto","type":"topic","abstract":[],"role":"symbol","navigatorTitle":[{"text":"ArticleDto","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticleDto","kind":"identifier"}]},"doc://VernissageServer/5Vapor17ResponseEncodableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor17ResponseEncodableP","title":"Vapor.ResponseEncodable"},"doc://VernissageServer/5Vapor21AsyncRequestDecodableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor21AsyncRequestDecodableP","title":"Vapor.AsyncRequestDecodable"},"doc://VernissageServer/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/s8SendableP","title":"Swift.Sendable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientUri":{"title":"clientUri","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clientUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientUri","type":"topic","abstract":[{"text":"URL string of a web page providing information about the client.","type":"text"},{"text":" ","type":"text"},{"text":"If present, the server SHOULD display this URL to the end-user in","type":"text"},{"text":" ","type":"text"},{"text":"a clickable fashion.  It is RECOMMENDED that clients always send","type":"text"},{"text":" ","type":"text"},{"text":"this field.  The value of this field MUST point to a valid web","type":"text"},{"text":" ","type":"text"},{"text":"page.  The value of this field MAY be internationalized, as","type":"text"},{"text":" ","type":"text"},{"text":"described in Section 2.2.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clienturi"},"doc://VernissageServer/5Vapor22AsyncResponseEncodableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor22AsyncResponseEncodableP","title":"Vapor.AsyncResponseEncodable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/AsyncRequestDecodable-Implementations":{"abstract":[],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/asyncrequestdecodable-implementations","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/AsyncRequestDecodable-Implementations","kind":"article","role":"collectionGroup","title":"AsyncRequestDecodable Implementations","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/redirectUris":{"abstract":[{"type":"text","text":"Array of redirection URI strings for use in redirect-based flows"},{"type":"text","text":" "},{"type":"text","text":"such as the authorization code and implicit flows.  As required by"},{"type":"text","text":" "},{"type":"text","text":"Section 2 of OAuth 2.0 [RFC6749], clients using flows with"},{"type":"text","text":" "},{"type":"text","text":"redirection MUST register their redirection URI values."},{"type":"text","text":" "},{"type":"text","text":"Authorization servers that support dynamic registration for"},{"type":"text","text":" "},{"type":"text","text":"redirect-based flows MUST implement support for this metadata"},{"type":"text","text":" "},{"type":"text","text":"value."}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/redirecturis","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"redirectUris","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/redirectUris","kind":"symbol","role":"symbol","title":"redirectUris","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/AttachmentDescriptionDto":{"url":"\/documentation\/vernissageserver\/attachmentdescriptiondto","type":"topic","title":"AttachmentDescriptionDto","abstract":[],"role":"symbol","navigatorTitle":[{"text":"AttachmentDescriptionDto","kind":"identifier"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AttachmentDescriptionDto","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AttachmentDescriptionDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/responseTypes":{"title":"responseTypes","kind":"symbol","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/responseTypes","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/responsetypes","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"responseTypes","kind":"identifier"},{"text":": [","kind":"text"},{"text":"OAuthResponseTypeDto","preciseIdentifier":"s:16VernissageServer20OAuthResponseTypeDtoO","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","abstract":[{"text":"Array of the OAuth 2.0 response type strings that the client can","type":"text"},{"text":" ","type":"text"},{"text":"use at the authorization endpoint.  These response types are","type":"text"},{"text":" ","type":"text"},{"text":"defined as follows:","type":"text"}]},"doc://VernissageServer/5Vapor7ContentP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor7ContentP","title":"Vapor.Content"},"doc://VernissageServer/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://VernissageServer/documentation/VernissageServer/ArticleFileInfoDto":{"navigatorTitle":[{"text":"ArticleFileInfoDto","kind":"identifier"}],"title":"ArticleFileInfoDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticleFileInfoDto","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/vernissageserver\/articlefileinfodto","type":"topic","abstract":[],"role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfoDto"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/jwksUri":{"title":"jwksUri","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/jwksuri","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwksUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"role":"symbol","abstract":[{"text":"URL string referencing the client’s JSON Web Key (JWK) Set","type":"text"},{"text":" ","type":"text"},{"text":"[RFC7517] document, which contains the client’s public keys.  The","type":"text"},{"text":" ","type":"text"},{"text":"value of this field MUST point to a valid JWK Set document.  These","type":"text"},{"text":" ","type":"text"},{"text":"keys can be used by higher-level protocols that use signing or","type":"text"},{"text":" ","type":"text"},{"text":"encryption.  For instance, these keys might be used by some","type":"text"},{"text":" ","type":"text"},{"text":"applications for validating signed requests made to the token","type":"text"},{"text":" ","type":"text"},{"text":"endpoint when using JWTs for client authentication [RFC7523].  Use","type":"text"},{"text":" ","type":"text"},{"text":"of this parameter is preferred over the “jwks” parameter, as it","type":"text"},{"text":" ","type":"text"},{"text":"allows for easier key rotation.  The “jwks_uri” and “jwks”","type":"text"},{"text":" ","type":"text"},{"text":"parameters MUST NOT both be present in the same request or","type":"text"},{"text":" ","type":"text"},{"text":"response.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwksUri","type":"topic","kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareVersion":{"title":"softwareVersion","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareVersion","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareVersion","type":"topic","abstract":[{"text":"A version identifier string for the client software identified by","type":"text"},{"text":" ","type":"text"},{"text":"“software_id”.  The value of the “software_version” SHOULD change","type":"text"},{"text":" ","type":"text"},{"text":"on any update to the client software identified by the same","type":"text"},{"text":" ","type":"text"},{"text":"“software_id”.  The value of this field is intended to be compared","type":"text"},{"text":" ","type":"text"},{"text":"using string equality matching and no other comparison semantics","type":"text"},{"text":" ","type":"text"},{"text":"are defined by this specification.  The value of this field is","type":"text"},{"text":" ","type":"text"},{"text":"outside the scope of this specification, but it is not intended to","type":"text"},{"text":" ","type":"text"},{"text":"be human readable and is usually opaque to the client and","type":"text"},{"text":" ","type":"text"},{"text":"authorization server.  The definition of what constitutes an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"update to client software that would trigger a change to this"},{"text":" ","type":"text"},{"text":"value is specific to the software itself and is outside the scope","type":"text"},{"text":" ","type":"text"},{"text":"of this specification.","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareversion"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/tosUri":{"title":"tosUri","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/tosuri","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tosUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"role":"symbol","abstract":[{"type":"text","text":"URL string that points to a human-readable terms of service"},{"type":"text","text":" "},{"type":"text","text":"document for the client that describes a contractual relationship"},{"type":"text","text":" "},{"type":"text","text":"between the end-user and the client that the end-user accepts when"},{"type":"text","text":" "},{"type":"text","text":"authorizing the client.  The authorization server SHOULD display"},{"type":"text","text":" "},{"type":"text","text":"this URL to the end-user if it is provided.  The value of this"},{"type":"text","text":" "},{"type":"text","text":"field MUST point to a valid web page.  The value of this field MAY"},{"type":"text","text":" "},{"type":"text","text":"be internationalized, as described in Section 2.2."}],"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/tosUri","kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubStatusJobDataDto":{"url":"\/documentation\/vernissageserver\/activitypubstatusjobdatadto","type":"topic","title":"ActivityPubStatusJobDataDto","abstract":[],"role":"symbol","navigatorTitle":[{"text":"ActivityPubStatusJobDataDto","kind":"identifier"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubStatusJobDataDto","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubStatusJobDataDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/scope":{"title":"scope","abstract":[{"text":"String containing a space-separated list of scope values (as","type":"text"},{"text":" ","type":"text"},{"text":"described in Section 3.3 of OAuth 2.0 [RFC6749]) that the client","type":"text"},{"text":" ","type":"text"},{"text":"can use when requesting access tokens.  The semantics of values in","type":"text"},{"text":" ","type":"text"},{"text":"this list are service specific.  If omitted, an authorization","type":"text"},{"text":" ","type":"text"},{"text":"server MAY register a client with a default set of scopes.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scope","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/scope","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/scope","kind":"symbol","role":"symbol"},"doc://VernissageServer/s9EscapableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/s9EscapableP","title":"Swift.Escapable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientName":{"title":"clientName","kind":"symbol","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientName","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clientname","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clientName","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"Human-readable string name of the client to be presented to the"},{"type":"text","text":" "},{"type":"text","text":"end-user during authorization.  If omitted, the authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY display the raw “client_id” value to the end-user"},{"type":"text","text":" "},{"type":"text","text":"instead.  It is RECOMMENDED that clients always send this field."},{"type":"text","text":" "},{"type":"text","text":"The value of this field MAY be internationalized, as described in"},{"type":"text","text":" "},{"type":"text","text":"Section 2.2."}],"type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/tokenEndpointAuthMethod":{"title":"tokenEndpointAuthMethod","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"tokenEndpointAuthMethod","kind":"identifier"},{"text":": ","kind":"text"},{"text":"OAuthTokenEndpointAuthMethodDto","kind":"typeIdentifier","preciseIdentifier":"s:16VernissageServer31OAuthTokenEndpointAuthMethodDtoO"},{"text":"?","kind":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/tokenEndpointAuthMethod","type":"topic","abstract":[{"text":"String indicator of the requested authentication method for the","type":"text"},{"text":" ","type":"text"},{"text":"token endpoint.  Values defined by this specification are:","type":"text"}],"role":"symbol","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/tokenendpointauthmethod"},"doc://VernissageServer/documentation/VernissageServer/ArchiveStatusDto":{"title":"ArchiveStatusDto","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArchiveStatusDto","kind":"identifier"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveStatusDto","type":"topic","abstract":[],"role":"symbol","navigatorTitle":[{"text":"ArchiveStatusDto","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/vernissageserver\/archivestatusdto"},"doc://VernissageServer/documentat