Identifier":"s:16VernissageServer31OAuthTokenEndpointAuthMethodDtoO","kind":"typeIdentifier","text":"OAuthTokenEndpointAuthMethodDto"},{"kind":"text","text":"?"}],"abstract":[{"text":"String indicator of the requested authentication method for the","type":"text"},{"text":" ","type":"text"},{"text":"token endpoint.  Values defined by this specification are:","type":"text"}]},"doc://VernissageServer/5Vapor21AsyncRequestDecodableP":{"type":"unresolvable","title":"Vapor.AsyncRequestDecodable","identifier":"doc:\/\/VernissageServer\/5Vapor21AsyncRequestDecodableP"},"doc://VernissageServer/documentation/VernissageServer/ArticleVisibilityDto":{"type":"topic","url":"\/documentation\/vernissageserver\/articlevisibilitydto","kind":"symbol","title":"ArticleVisibilityDto","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleVisibilityDto","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticleVisibilityDto","kind":"identifier"}],"navigatorTitle":[{"text":"ArticleVisibilityDto","kind":"identifier"}],"abstract":[]},"doc://VernissageServer/documentation/VernissageServer/ArticleDto":{"type":"topic","url":"\/documentation\/vernissageserver\/articledto","kind":"symbol","title":"ArticleDto","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticleDto","kind":"identifier"}],"navigatorTitle":[{"text":"ArticleDto","kind":"identifier"}],"abstract":[]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/Validatable-Implementations":{"type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/validatable-implementations","kind":"article","title":"Validatable Implementations","role":"collectionGroup","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Validatable-Implementations","abstract":[]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/CodingKeys":{"title":"RegisterOAuthClientRequestDto.CodingKeys","type":"topic","role":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/codingkeys","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"CodingKeys","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"CodingKeys"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/CodingKeys","abstract":[]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/jwks":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwks","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/jwks","title":"jwks","abstract":[{"text":"Client’s JSON Web Key Set [RFC7517] document value, which contains","type":"text"},{"text":" ","type":"text"},{"text":"the client’s public keys.  The value of this field MUST be a JSON","type":"text"},{"text":" ","type":"text"},{"text":"object containing a valid JWK Set.  These keys can be used by","type":"text"},{"text":" ","type":"text"},{"text":"higher-level protocols that use signing or encryption.  This","type":"text"},{"text":" ","type":"text"},{"text":"parameter is intended to be used by clients that cannot use the","type":"text"},{"text":" ","type":"text"},{"text":"“jwks_uri” parameter, such as native clients that cannot host","type":"text"},{"text":" ","type":"text"},{"text":"public URLs.  The “jwks_uri” and “jwks” parameters MUST NOT both","type":"text"},{"text":" ","type":"text"},{"text":"be present in the same request or response.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwks"},"doc://VernissageServer/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/VernissageServer\/s16SendableMetatypeP"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubFollowRequestDto":{"type":"topic","url":"\/documentation\/vernissageserver\/activitypubfollowrequestdto","kind":"symbol","title":"ActivityPubFollowRequestDto","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubFollowRequestDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubFollowRequestDto","kind":"identifier"}],"navigatorTitle":[{"text":"ActivityPubFollowRequestDto","kind":"identifier"}],"abstract":[]},"doc://VernissageServer/Se":{"type":"unresolvable","title":"Swift.Decodable","identifier":"doc:\/\/VernissageServer\/Se"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareVersion":{"type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareversion","kind":"symbol","title":"softwareVersion","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareVersion","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"softwareVersion"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"text":"A version identifier string for the client software identified by","type":"text"},{"text":" ","type":"text"},{"text":"“software_id”.  The value of the “software_version” SHOULD change","type":"text"},{"text":" ","type":"text"},{"text":"on any update to the client software identified by the same","type":"text"},{"text":" ","type":"text"},{"text":"“software_id”.  The value of this field is intended to be compared","type":"text"},{"text":" ","type":"text"},{"text":"using string equality matching and no other comparison semantics","type":"text"},{"text":" ","type":"text"},{"text":"are defined by this specification.  The value of this field is","type":"text"},{"text":" ","type":"text"},{"text":"outside the scope of this specification, but it is not intended to","type":"text"},{"text":" ","type":"text"},{"text":"be human readable and is usually opaque to the client and","type":"text"},{"text":" ","type":"text"},{"text":"authorization server.  The definition of what constitutes an","type":"text"},{"text":" ","type":"text"},{"text":"update to client software that would trigger a change to this","type":"text"},{"text":" ","type":"text"},{"text":"value is specific to the software itself and is outside the scope","type":"text"},{"text":" ","type":"text"},{"text":"of this specification.","type":"text"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareId":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareId","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareid","title":"softwareId","abstract":[{"type":"text","text":"A unique identifier string (e.g., a Universally Unique Identifier"},{"type":"text","text":" "},{"type":"text","text":"(UUID)) assigned by the client developer or software publisher"},{"type":"text","text":" "},{"type":"text","text":"used by registration endpoints to identify the client software to"},{"type":"text","text":" "},{"type":"text","text":"be dynamically registered.  Unlike “client_id”, which is issued by"},{"type":"text","text":" "},{"type":"text","text":"the authorization server and SHOULD vary between instances, the"},{"type":"text","text":" "},{"type":"text","text":"“software_id” SHOULD remain the same for all instances of the"},{"type":"text","text":" "},{"type":"text","text":"client software.  The “software_id” SHOULD remain the same across"},{"type":"text","text":" "},{"type":"text","text":"multiple updates or versions of the same piece of software.  The"},{"type":"text","text":" "},{"type":"text","text":"value of this field is not intended to be human readable and is"},{"type":"text","text":" "},{"type":"text","text":"usually opaque to the client and authorization server."}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareId"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubProfileUpdateJobDto":{"type":"topic","url":"\/documentation\/vernissageserver\/activitypubprofileupdatejobdto","kind":"symbol","title":"ActivityPubProfileUpdateJobDto","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubProfileUpdateJobDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubProfileUpdateJobDto","kind":"identifier"}],"navigatorTitle":[{"text":"ActivityPubProfileUpdateJobDto","kind":"identifier"}],"abstract":[]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/logoUri":{"role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"logoUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/logouri","title":"logoUri","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/logoUri","abstract":[{"type":"text","text":"URL string that references a logo for the client.  If present, the"},{"type":"text","text":" "},{"type":"text","text":"server SHOULD display this image to the end-user during approval."},{"type":"text","text":" "},{"type":"text","text":"The value of this field MUST point to a valid image file.  The"},{"type":"text","text":" "},{"type":"text","text":"value of this field MAY be internationalized, as described in"},{"type":"text","text":" "},{"type":"text","text":"Section 2.2."}]},"doc://VernissageServer/5Vapor11ValidatableP":{"title":"Vapor.Validatable","identifier":"doc:\/\/VernissageServer\/5Vapor11ValidatableP","type":"unresolvable"},"doc://VernissageServer/documentation/VernissageServer/ArchiveDto":{"type":"topic","url":"\/documentation\/vernissageserver\/archivedto","kind":"symbol","title":"ArchiveDto","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArchiveDto","kind":"identifier"}],"navigatorTitle":[{"text":"ArchiveDto","kind":"identifier"}],"abstract":[]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/Decodable-Implementations":{"role":"collectionGroup","type":"topic","kind":"article","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/decodable-implementations","title":"Decodable Implementations","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Decodable-Implementations","abstract":[]},"doc://VernissageServer/documentation/VernissageServer/ActivityPubUnreblogDto":{"type":"topic","url":"\/documentation\/vernissageserver\/activitypubunreblogdto","kind":"symbol","title":"ActivityPubUnreblogDto","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubUnreblogDto","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubUnreblogDto","kind":"identifier"}],"navigatorTitle":[{"text":"ActivityPubUnreblogDto","kind":"identifier"}],"abstract":[]},"doc://VernissageServer