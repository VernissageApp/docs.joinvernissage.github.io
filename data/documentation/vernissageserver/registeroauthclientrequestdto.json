":"symbol","navigatorTitle":[{"text":"ActivityPubFollowRespondDto","kind":"identifier"}],"abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubFollowRespondDto","kind":"identifier"}]},"doc://VernissageServer/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/VernissageServer\/s16SendableMetatypeP","type":"unresolvable"},"doc://VernissageServer/documentation/VernissageServer/ArticleFileInfoDto":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ArticleFileInfoDto"}],"navigatorTitle":[{"kind":"identifier","text":"ArticleFileInfoDto"}],"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfoDto","role":"symbol","url":"\/documentation\/vernissageserver\/articlefileinfodto","title":"ArticleFileInfoDto"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientName":{"abstract":[{"type":"text","text":"Human-readable string name of the client to be presented to the"},{"type":"text","text":" "},{"type":"text","text":"end-user during authorization.  If omitted, the authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY display the raw “client_id” value to the end-user"},{"type":"text","text":" "},{"type":"text","text":"instead.  It is RECOMMENDED that clients always send this field."},{"type":"text","text":" "},{"type":"text","text":"The value of this field MAY be internationalized, as described in"},{"type":"text","text":" "},{"type":"text","text":"Section 2.2."}],"kind":"symbol","role":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clientname","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientName","title":"clientName","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clientName","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareVersion":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareversion","kind":"symbol","abstract":[{"type":"text","text":"A version identifier string for the client software identified by"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of the “software_version” SHOULD change"},{"type":"text","text":" "},{"type":"text","text":"on any update to the client software identified by the same"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of this field is intended to be compared"},{"type":"text","text":" "},{"type":"text","text":"using string equality matching and no other comparison semantics"},{"type":"text","text":" "},{"type":"text","text":"are defined by this specification.  The value of this field is"},{"type":"text","text":" "},{"type":"text","text":"outside the scope of this specification, but it is not intended to"},{"type":"text","text":" "},{"type":"text","text":"be human readable and is usually opaque to the client and"},{"type":"text","text":" "},{"type":"text","text":"authorization server.  The definition of what constitutes an"},{"type":"text","text":" "},{"type":"text","text":"update to client software that would trigger a change to this"},{"type":"text","text":" "},{"type":"text","text":"value is specific to the software itself and is outside the scope"},{"type":"text","text":" "},{"type":"text","text":"of this specification."}],"title":"softwareVersion","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareVersion","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}]