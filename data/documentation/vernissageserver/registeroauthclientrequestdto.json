umentation\/VernissageServer\/AttachmentDescriptionDto","kind":"symbol","url":"\/documentation\/vernissageserver\/attachmentdescriptiondto","title":"AttachmentDescriptionDto","role":"symbol"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubStatusJobDataDto":{"url":"\/documentation\/vernissageserver\/activitypubstatusjobdatadto","type":"topic","kind":"symbol","abstract":[],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubStatusJobDataDto","kind":"identifier"}],"title":"ActivityPubStatusJobDataDto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubStatusJobDataDto","navigatorTitle":[{"kind":"identifier","text":"ActivityPubStatusJobDataDto"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareVersion":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareVersion","abstract":[{"type":"text","text":"A version identifier string for the client software identified by"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of the “software_version” SHOULD change"},{"type":"text","text":" "},{"type":"text","text":"on any update to the client software identified by the same"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of this field is intended to be compared"},{"type":"text","text":" "},{"type":"text","text":"using string equality matching and no other comparison semantics"},{"type":"text","text":" "},{"type":"text","text":"are defined by this specification.  The value of this field is"},{"type":"text","text":" "},{"type":"text","text":"outside the scope of this specification, but it is not intended to"},{"type":"text","text":" "},{"type":"text","text":"be human readable and is usually opaque to the client and"},{"type":"text","text":" "},{"type":"text","text":"authorization server.  The definition of what constitutes an"},{"type":"text","text":" "},{"type":"text","text":"update to client software that would trigger a change to this"},{"type":"text","text":" "},{"type":"text","text":"value is specific to the software itself and is outside the scope"},{"type":"text","text":" "},{"type":"text","text":"of this specification."}],"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareversion","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareVersion","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"title":"softwareVersion","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/CodingKeys":{"title":"RegisterOAuthClientRequestDto.CodingKeys","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/codingkeys","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/CodingKeys","navigatorTitle":[{"text":"CodingKeys","kind":"identifier"}],"abstract":[],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"CodingKeys","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/tokenEndpointAuthMethod":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"tokenEndpointAuthMethod"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:16VernissageServer31OAuthTokenEndpointAuthMethodDtoO","text":"OAuthTokenEndpointAuthMethodDto"},{"kind":"text","text":"?"}],"abstract":[{"text":"String indicator of the requested authentication method for the","type":"text"},{"text":" ","type":"text"},{"text":"token endpoint.  Values defined by this specification are:","type":"text"}],"type":"topic","identifier":"do