ageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwksUri","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/jwksuri","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwksUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","title":"jwksUri","abstract":[{"type":"text","text":"URL string referencing the client’s JSON Web Key (JWK) Set"},{"type":"text","text":" "},{"text":"[RFC7517] document, which contains the client’s public keys.  The","type":"text"},{"type":"text","text":" "},{"type":"text","text":"value of this field MUST point to a valid JWK Set document.  These"},{"type":"text","text":" "},{"text":"keys can be used by higher-level protocols that use signing or","type":"text"},{"text":" ","type":"text"},{"text":"encryption.  For instance, these keys might be used by some","type":"text"},{"type":"text","text":" "},{"text":"applications for validating signed requests made to the token","type":"text"},{"text":" ","type":"text"},{"text":"endpoint when using JWTs for client authentication [RFC7523].  Use","type":"text"},{"text":" ","type":"text"},{"text":"of this parameter is preferred over the “jwks” parameter, as it","type":"text"},{"text":" ","type":"text"},{"text":"allows for easier key rotation.  The “jwks_uri” and “jwks”","type":"text"},{"text":" ","type":"text"},{"text":"parameters MUST NOT both be present in the same request or","type":"text"},{"text":" ","type":"text"},{"text":"response.","type":"text"}]},"doc://VernissageServer/documentation/VernissageServer/AccessTokenDto":{"abstract":[{"type":"text","text":"An entity that stores credential token data."}],"title":"AccessTokenDto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AccessTokenDto","type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/accesstokendto","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"AccessTokenDto"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AccessTokenDto"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/CodingKeys":{"abstract":[],"title":"RegisterOAuthClientRequestDto.CodingKeys","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/CodingKeys","type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/codingkeys","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"CodingKeys"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"CodingKeys"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/grantTypes":{"title":"grantTypes","role":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/granttypes","kind":"symbol","abstract":[{"text":"Array of OAuth 2.0 grant type strings that the client can use at","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the token endpoint.  These grant types are defined as follows:"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"grantTypes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:16VernissageServer17OAuthGrantTypeDtoO","text":"OAuthGrantTypeDto"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/grantTypes","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/logoUri":{"title":"logoUri","role":"symbol","abstract":[{"type":"text","text":"URL string that references a logo for the client.  If present, the"},{"type":"text","text":" "},{"type":"text","text":"server SHOULD display this image to the end-user during approval."},{"type":"text","text":" "},{"type":"text","text":"The value of this field MUST point to a valid image file.  The"},{"type":"text","text":" "},{"type":"text","text":"value of this field MAY be internationalized, as described in"},{"type":"text","text":" "},{"type":"text","text":"Section 2.2."}],"kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/logouri","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"logoUri"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/logoUri","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/tokenEndpointAuthMethod":{"title":"tokenEndpointAuthMethod","role":"symbol","abstract":[{"type":"text","text":"String indicator of the requested authentication method for the"},{"type":"text","text":" "},{"type":"text","text":"token endpoint.  Values defined by this specification are:"}],"kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/tokenendpointauthmethod","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"tokenEndpointAuthMethod"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:16VernissageServer31OAuthTokenEndpointAuthMethodDtoO","text":"OAuthTokenEndpointAuthMethodDto"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/tokenEndpointAuthMethod","type":"topic"},"doc://VernissageServer/s9EscapableP":{"title":"Swift.Escapable","type":"unresolvable","identifier":"doc:\/\/VernissageServer\/s9EscapableP"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/RequestDecodable-Implementations":{"abstract":[],"kind":"article","title":"RequestDecodable Implementations","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/RequestDecodable-Implementations","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/requestdecodable-implementations","role":"collectionGroup"},"doc://VernissageServer/5Vapor16RequestDecodableP":{"title":"Vapor.RequestDecodable","type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor16RequestDecodableP"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/softwareVersion":{"abstract":[{"type":"text","text":"A version identifier string for the client software identified by"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of the “software_version” SHOULD change"},{"type":"text","text":" "},{"type":"text","text":"on any update to the client software identified by the same"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of this field is intended to be compared"},{"type":"text","text":" "},{"type":"text","text":"using string equality matching and no other comparison semantics"},{"type":"text","text":" "},{"type":"text","text":"are defined by this specification.  The value of this field is"},{"type":"text","text":" "},{"type":"text","text":"outside the scope of this specification, but it is not intended to"},{"type":"text","text":" "},{"type":"text","text":"be human readable and is usually opaque to the client and"},{"type":"text","text":" "},{"type":"text","text":"authorization server.  The definition of what constitutes an"},{"type":"text","text":" "},{"type":"text","text":"update to client software that would trigger a change to this"},{"type":"text","text":" "},{"type":"text","text":"value is specific to the software itself and is outside the scope"},{"type":"text","text":" "},{"type":"text","text":"of this specification."}],"kind":"symbol","title":"softwareVersion","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/softwareVersion","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareversion","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"softwareVersion"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/scope":{"abstract":[{"type":"text","text":"String containing a space-separated list of scope values (as"},{"type":"text","text":" "},{"type":"text","text":"described in Section 3.3 of OAuth 2.0 [RFC6749]) that the client"},{"type":"text","text":" "},{"type":"text","text":"can use when requesting access tokens.  The semantics of values in"},{"type":"text","text":" "},{"type":"text","text":"this list are service specific.  If omitted, an authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY register a client with a default set of scopes."}],"kind":"symbol","title":"scope","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/scope","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/scope","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"scope"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/redirectUris":{"abstract":[{"type":"text","text":"Array of redirection URI strings for use in redirect-based flows"},{"type":"text","text":" "},{"type":"text","text":"such as the authorization code and implicit flows.  As required by"},{"type":"text","text":" "},{"type":"text","text":"Section 2 of OAuth 2.0 [RFC6749], clients using flows with"},{"type":"text","text":" "},{"type":"text","text":"redirection MUST register their redirection URI values."},{"type":"text","text":" "},{"type":"text","text":"Authorization servers that support dynamic registration for"},{"type":"text","text":" "},{"type":"text","text":"redirect-based flows MUST implement support for this metadata"},{"type":"text","text":" "},{"type":"text","text":"value."}],"kind":"symbol","title":"redirectUris","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/redirectUris","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/redirecturis","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"redirectUris"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}]},"doc://VernissageServer/documentation/VernissageServer/ActivityPubUnreblogDto":{"abstract":[],"title":"ActivityPubUnreblogDto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubUnreblogDto","type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/activitypubunreblogdto","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ActivityPubUnreblogDto"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActivityPubUnreblogDto"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/contacts":{"url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/contacts","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"contacts"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]?"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Array of strings representing ways to contact people responsible"},{"type":"text","text":" "},{"type":"text","text":"for this client, typically email addresses.  The authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY make these contact addresses available to end-users for"},{"type":"text","text":" "},{"type":"text","text":"support requests for the client.  See Section 6 for information on"},{"type":"text","text":" "},{"type":"text","text":"Privacy Considerations."}],"role":"symbol","title":"contacts","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/contacts"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/Decodable-Implementations":{"abstract":[],"kind":"article","title":"Decodable Implementations","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Decodable-Implementations","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/decodable-implementations","role":"collectionGroup"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubReblogDto":{"abstract":[],"title":"ActivityPubReblogDto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubReblogDto","type":"topic","kind":"symbol","url":"\/documentation\/vernissageserver\/activitypubreblogdto","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ActivityPubReblogDto"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActivityPubReblogDto"}]},"doc://VernissageServer/SE":{"title":"Swift.Encodable","type":"unresolvable","identifier":"doc:\/\/VernissageServer\/SE"},"doc://VernissageServer/5Vapor21AsyncRequestDecodableP":{"title":"Vapor.AsyncRequestDecodable","type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor21AsyncRequestDecodableP"},"doc://VernissageServer/documentation/Vernissag