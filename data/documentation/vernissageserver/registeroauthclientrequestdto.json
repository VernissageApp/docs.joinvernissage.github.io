pe":"text","text":" "},{"type":"text","text":"parameter is intended to be used by clients that cannot use the"},{"type":"text","text":" "},{"type":"text","text":"“jwks_uri” parameter, such as native clients that cannot host"},{"type":"text","text":" "},{"type":"text","text":"public URLs.  The “jwks_uri” and “jwks” parameters MUST NOT both"},{"type":"text","text":" "},{"type":"text","text":"be present in the same request or response."}],"type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"jwks","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"title":"jwks","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwks"},"doc://VernissageServer/5Vapor17ResponseEncodableP":{"type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor17ResponseEncodableP","title":"Vapor.ResponseEncodable"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientName":{"kind":"symbol","abstract":[{"type":"text","text":"Human-readable string name of the client to be presented to the"},{"type":"text","text":" "},{"text":"end-user during authorization.  If omitted, the authorization","type":"text"},{"text":" ","type":"text"},{"text":"server MAY display the raw “client_id” value to the end-user","type":"text"},{"text":" ","type":"text"},{"text":"instead.  It is RECOMMENDED that clients always send this field.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The value of this field MAY be internationalized, as described in"},{"type":"text","text":" "},{"type":"text","text":"Section 2.2."}],"role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientName","type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clientname","title":"clientName","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"clientName"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"doc://VernissageServer/documentation/VernissageServer/AccessTokenDto":{"url":"\/documentation\/vernissageserver\/accesstokendto","type":"topic","abstract":[{"type":"text","text":"An entity that stores credential token data."}],"kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AccessTokenDto","kind":"identifier"}],"title":"AccessTokenDto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AccessTokenDto","navigatorTitle":[{"text":"AccessTokenDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer/ArticleFileInfoDto":{"title":"ArticleFileInfoDto","url":"\/documentation\/vernissageserver\/articlefileinfodto","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfoDto","navigatorTitle":[{"text":"ArticleFileInfoDto","kind":"identifier"}],"abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticleFileInfoDto","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/clientUri":{"kind":"symbol","abstract":[{"text":"URL string of a web page providing information about the client.","type":"text"},{"text":" ","type":"text"},{"text":"If present, the server SHOULD display this URL to the end-user in","type":"text"},{"text":" ","type":"text"},{"text":"a clickable fashion.  It is RECOMMENDED that clients always send","type":"text"},{"text":" ","type":"text"},{"text":"this field.  The value of this field MUST point to a valid web","type":"text"},{"text":" ","type":"text"},{"text":"page.  The value of this field MAY be internationalized, as","type":"text"},{"text":" ","type":"text"},{"text":"described in Section 2.2.","type":"text"}],"role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/clientUri","type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/clienturi","title":"clientUri","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clientUri","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/jwksUri":{"role":"symbol","kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/jwksUri","abstract":[{"type":"text","text":"URL string referencing the client’s JSON Web Key (JWK) Set"},{"type":"text","text":" "},{"type":"text","text":"[RFC7517] document, which contains the client’s public keys.  The"},{"type":"text","text":" "},{"type":"text","text":"value of this field MUST point to a valid JWK Set document.  These"},{"type":"text","text":" "},{"type":"text","text":"keys can be used by higher-level protocols that use signing or"},{"type":"text","text":" "},{"type":"text","text":"encryption.  For instance, these keys might be used by some"},{"type":"text","text":" "},{"type":"text","text":"applications for validating signed requests made to the token"},{"type":"text","text":" "},{"type":"text","text":"endpoint when using JWTs for client authentication [RFC7523].  Use"},{"type":"text","text":" "},{"type":"text","text":"of this parameter is preferred over the “jwks” parameter, as it"},{"type":"text","text":" "},{"type":"text","text":"allows for easier key rotation.  The “jwks_uri” and “jwks”"},{"type":"text","text":" "},{"type":"text","text":"parameters MUST NOT both be present in the same request or"},{"type":"text","text":" "},{"type":"text","text":"response."}