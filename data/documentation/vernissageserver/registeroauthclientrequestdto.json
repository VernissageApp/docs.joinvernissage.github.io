{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RegisterOAuthClientRequestDto"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Registered clients have a set of metadata values associated with"},{"type":"text","text":" "},{"type":"text","text":"their client identifier at an authorization server, such as the list"},{"type":"text","text":" "},{"type":"text","text":"of valid redirection URIs or a display name."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These client metadata values are used in two ways:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"as input values to registration requests, and","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"as output values in registration responses.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The following client metadata fields are defined by this"},{"type":"text","text":" "},{"type":"text","text":"specification.  The implementation and use of all client metadata"},{"type":"text","text":" "},{"type":"text","text":"fields is OPTIONAL, unless stated otherwise.  All data member types"},{"type":"text","text":" "},{"type":"text","text":"(strings, arrays, numbers) are defined in terms of their JSON"},{"type":"text","text":" "},{"type":"text","text":"[RFC7159] representations."}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/VernissageServer\/s8CopyableP","doc:\/\/VernissageServer\/Se","doc:\/\/VernissageServer\/SE","doc:\/\/VernissageServer\/s9EscapableP","doc:\/\/VernissageServer\/s8SendableP","doc:\/\/VernissageSe