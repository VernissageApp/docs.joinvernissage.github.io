text"},{"text":"(UUID)) assigned by the client developer or software publisher","type":"text"},{"text":" ","type":"text"},{"text":"used by registration endpoints to identify the client software to","type":"text"},{"text":" ","type":"text"},{"text":"be dynamically registered.  Unlike “client_id”, which is issued by","type":"text"},{"text":" ","type":"text"},{"text":"the authorization server and SHOULD vary between instances, the","type":"text"},{"text":" ","type":"text"},{"text":"“software_id” SHOULD remain the same for all instances of the","type":"text"},{"text":" ","type":"text"},{"text":"client software.  The “software_id” SHOULD remain the same across","type":"text"},{"text":" ","type":"text"},{"text":"multiple updates or versions of the same piece of software.  The","type":"text"},{"text":" ","type":"text"},{"text":"value of this field is not intended to be human readable and is","type":"text"},{"text":" ","type":"text"},{"text":"usually opaque to the client and authorization server.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"softwareId","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"?","kind":"text"}],"title":"softwareId","role":"symbol","kind":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/softwareid"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientRequestDto/Content-Implementations":{"role":"collectionGroup","kind":"article","url":"\/documentation\/vernissageserver\/registeroauthclientrequestdto\/content-implementations","title":"Content Implementations","abstract":[],"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientRequestDto\/Content-Implementations"},"doc://VernissageServer/s9EscapableP":{"title":"Swift.Escapable","identifier":"doc:\/\/VernissageServer\/s9EscapableP","type":"unresolvable"},"doc://Vernissa