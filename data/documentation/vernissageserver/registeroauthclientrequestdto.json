text":" ","kind":"text"},{"text":"RegisterOAuthClientRequestDto","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Registered clients have a set of metadata values associated with","type":"text"},{"text":" ","type":"text"},{"text":"their client identifier at an authorization server, such as the list","type":"text"},{"text":" ","type":"text"},{"text":"of valid redirection URIs or a display name.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"These client metadata values are used in two ways:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"as input values to registration requests, and"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"as output values in registration responses."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The following client metadata fields are defined by this","type":"text"},{"text":" ","type":"text"},{"text":"specification.  The implementation and use of all client metadata","type":"text"},{"text":" ","type":"text"},{"text":"fields is OPTIONAL, unless stated otherwise.  All data member types","type":"text"},{"text":" ","type":"text"},{"text":"(strings, arrays, numbers) are defined in terms of their JSON","type":"text"},{"text":" ","type":"text"},{"text":"[RFC7159] representations.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/vernissageserver\/registeroauthclientrequestdto"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://VernissageServer/documentation/VernissageServer/ActivityPubRequestPath":{"navigatorTitle":[{"text":"ActivityPubRequestPath","kind":"identifier"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubRequestPath","kind":"identifier"}],"abstract":[],"type":"topic","identifier":"d