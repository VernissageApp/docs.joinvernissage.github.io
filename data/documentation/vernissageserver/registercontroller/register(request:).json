{"abstract":[{"type":"text","text":"Register new user."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserver\/registercontroller\/register(request:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@Sendable","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"register","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Request","kind":"typeIdentifier","preciseIdentifier":"s:5Vapor7RequestC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","kind":"typeIdentifier","preciseIdentifier":"s:5Vapor8ResponseC"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The Vapor request to the endpoint "},{"type":"reference","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterUserDto","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"request"}]},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entity "},{"type":"reference","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/UserDto","isActive":true},{"type":"text","text":" with new generated "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."}]}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a new user account in the system. After registration, the user can use the system, but until he confirms his e-mail address,"},{"type":"text","text":" "},{"type":"text","text":"access is limited. For example, the user cannot add new statuses. It is also recommended to configure "},{"type":"codeVoice","code":"captcha"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which will prevent bots from creating accounts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Client application can rertieve captcha image by executing this request: "},{"type":"codeVoice","code":"\/api\/vi\/quick-captcha\/generate?key=435nkerguh8734bw"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The key value it’s 16 randaom characters which have to be generated by client. Then in the reuest JSON, client have to combine"},{"type":"text","text":" "},{"type":"text","text":"this key with user entered text (seprated by "},{"type":"codeVoice","code":"\/"},{"type":"text","text":"), eg: "},{"type":"codeVoice","code":"435nkerguh8734bw\/KUbaPS"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"During account creation process server will send to the user inbox email with information how to confirm his email address."},{"type":"text","text":" "},{"type":"text","text":"In the email there will be link with address to the client application (from "},{"type":"codeVoice","code":"redirectBaseUrl"},{"type":"text","text":"). Client application should"},{"type":"text","text":" "},{"type":"text","text":"serve the page will can retrieve two parameters:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"token","type":"codeVoice"},{"text":" - string, GUID","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"userId","type":"codeVoice"},{"text":" - new user identifier","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Client application have to read that parameters and use endpoint "},{"type":"codeVoice","code":"POST \/api\/v1\/account\/email\/confirm"},{"type":"text","text":" to confirm the email."}]},{"content":[{"inlineContent":[{"type":"text","text":"Endpoint URL: "},{"type":"codeVoice","code":"\/api\/v1\/account\/register"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CURL request:"}],"type":"strong"}]},{"type":"codeListing","code":["curl \"https:\/\/example.com\/api\/v1\/register\" \\","-X POST \\","-H \"Content-Type: application\/json\" \\","-d '{ ... }'"],"syntax":"bash"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example request body:"}],"type":"strong"}]},{"type":"codeListing","code":["{","    \"userName\": \"johndoe\",","    \"email\": \"johndoe@email.com\",","    \"password\": \"P@ssword1!\",","    \"redirectBaseUrl\": \"https:\/\/example.com\",","    \"agreement\": true,","    \"name\": \"John Doe\",","    \"bio\": \"I'm a photographer...\",","    \"securityToken\": \"435nkerguh8734bw\/KUbaPS\",","    \"locale\": \"en_US\",","    \"reason\": \"I would like to share with you my photos...\",","    \"inviteToken\": \"34egdfert9fyg7d8fbt9sd\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example response body (200 OK):"}],"type":"strong"}]},{"type":"codeListing","code":["{","    \"id\": \"7243149752689283073\",","    \"userName\": \"johndoe\",","    \"account\": \"johndoe@example.com\",","    \"email\": \"johndoe@email.com\",","    \"name\": \"John Doe\",","    \"bio\": \"I'm a photographer...\",","    \"avatarUrl\": \"https:\/\/example.com\/storage\/454kwffvsr453sdfsd2345wevsdf.jpg\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example response body (field validation):"}],"type":"strong"}]},{"type":"codeListing","code":["{","    \"code\": \"validationError\",","    \"reason\": \"Validation errors occurs.\",","    \"failures\": [","        {","            \"field\": \"email\",","            \"failure\": \"is not a valid email address\"","        },","        {","            \"field\": \"redirectBaseUrl\",","            \"failure\": \"is an invalid URL\"","        }","    ],","    \"error\": true","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Example response body (business logic validation):"}],"type":"strong"}]},{"type":"codeListing","code":["{","    \"code\": \"userNameIsAlreadyTaken\",","    \"reason\": \"User with provided user name already exists in the system.\"","}"],"syntax":"json"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"Validation.validationError"},{"type":"text","text":" if validation errors occurs."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.securityTokenIsMandatory"},{"type":"text","text":" if security token is mandatory (security token is combination of: "},{"type":"codeVoice","code":"key\/text"},{"type":"text","text":")."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.securityTokenIsInvalid"},{"type":"text","text":" if security token is invalid."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.userNameIsAlreadyTaken"},{"type":"text","text":" if user with provided user name already exists in the system."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.emailIsAlreadyConnected"},{"type":"text","text":" if email is already connected with other account."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Throws"},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.missingEmail"},{"type":"text","text":" if email has not been specified but it’s mandatory."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.missingEmailConfirmationGuid"},{"type":"text","text":"if email confirmation guid has not been generated."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.registrationIsDisabled"},{"type":"text","text":"if registration is disabled."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.userHaveToAcceptAgreement"},{"type":"text","text":" if user have to accept agreement."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.reasonIsMandatory"},{"type":"text","text":" if reason is mandatory when only registration by approval is enabled."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.invitationTokenIsInvalid"},{"type":"text","text":" if invitation token is invalid."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.invitationTokenHasBeenUsed"},{"type":"text","text":" if invitation token has been used."}],"type":"paragraph"}]},{"name":"Throws","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"RegisterError.userIdNotExists"},{"type":"text","text":" if user Id not exists. Probably saving of the user entity failed."}],"type":"paragraph"}]},{"name":"Throws","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"RegisterError.disposableEmailCannotBeUsed","type":"codeVoice"},{"text":" if disposabled email has been used.","type":"text"}]}],"style":"note"}],"kind":"content"}],"metadata":{"symbolKind":"method","role":"symbol","title":"register(request:)","externalID":"s:16VernissageServer18RegisterControllerV8register7request5Vapor8ResponseCAF7RequestC_tYaYbKF","modules":[{"name":"Vernissage"}],"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"register","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Request","kind":"typeIdentifier","preciseIdentifier":"s:5Vapor7RequestC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","kind":"typeIdentifier","preciseIdentifier":"s:5Vapor8ResponseC"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterController\/register(request:)"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterController"]]},"references":{"doc://VernissageServer/documentation/VernissageServer":{"abstract":[{"text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across","type":"text"},{"text":" ","type":"text"},{"text":"the fediverse - offering powerful features you won’t find anywhere else.","type":"text"}],"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","title":"Vernissage","role":"collection","kind":"symbol",