{"kind":"symbol","abstract":[{"type":"text","text":"Authorization endpoint - used by the client to obtain authorization from"},{"type":"text","text":" "},{"type":"text","text":"the resource owner via user-agent redirection."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@Sendable","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Request","kind":"typeIdentifier","preciseIdentifier":"s:5Vapor7RequestC"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","kind":"typeIdentifier","preciseIdentifier":"s:5Vapor8ResponseC"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The authorization endpoint is used to interact with the resource","type":"text"},{"text":" ","type":"text"},{"text":"owner and obtain an authorization grant.  The authorization server","type":"text"},{"text":" ","type":"text"},{"text":"MUST first verify the identity of the resource owner.  The way in","type":"text"},{"text":" ","type":"text"},{"text":"which the authorization server authenticates the resource owner","type":"text"},{"text":" ","type":"text"},{"text":"(e.g., username and password login, session cookies) is beyond the","type":"text"},{"text":" ","type":"text"},{"text":"scope of this specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the client directs the user-agent to make the following","type":"text"},{"text":" ","type":"text"},{"text":"HTTP request using TLS:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CURL request:"}],"type":"strong"}]},{"type":"codeListing","code":["curl \"https:\/\/example.com\/api\/v1\/oauth\/authorize?response_type=code&client_id=s6BhdRkqt3&state=xyz&redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb\" \\","-X GET"],"syntax":"bash"},{"type":"paragraph","inlineContent":[{"text":"After that request user is redirected to login page (it it’s not already signed in)","type":"text"},{"text":" ","type":"text"},{"text":"or to authorization page. After authorization redirection to specified ","type":"text"},{"code":"redirect_uri","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is done (with ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" which can be replaced for the access token in token endpoint).","type":"text"}]}]}],"metadata":{"title":"authenticate(request:)","symbolKind":"method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Vapor7RequestC","kind":"typeIdentifier","text":"Request"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Response","preciseIdentifier":"s:5Vapor8ResponseC"}],"modules":[{"name":"Vernissage"}],"externalID":"s:16VernissageServer15OAuthControllerV12authenticate7request5Vapor8ResponseCAF7RequestC_tYaYbKF","roleHeading":"Instance Method"},"identifier":{"url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController\/authenticate(request:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserv