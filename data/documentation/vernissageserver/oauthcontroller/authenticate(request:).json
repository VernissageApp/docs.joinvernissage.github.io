"kind":"typeIdentifier","text":"Response"}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"text":"The authorization endpoint is used to interact with the resource","type":"text"},{"text":" ","type":"text"},{"text":"owner and obtain an authorization grant.  The authorization server","type":"text"},{"text":" ","type":"text"},{"text":"MUST first verify the identity of the resource owner.  The way in","type":"text"},{"text":" ","type":"text"},{"text":"which the authorization server authenticates the resource owner","type":"text"},{"text":" ","type":"text"},{"text":"(e.g., username and password login, session cookies) is beyond the","type":"text"},{"text":" ","type":"text"},{"text":"scope of this specification.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For example, the client directs the user-agent to make the following","type":"text"},{"text":" ","type":"text"},{"text":"HTTP request using TLS:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"CURL request:"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","code":["curl \"https:\/\/example.com\/api\/v1\/oauth\/authorize?response_type=code&client_id=s6BhdRkqt3&state=xyz&redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb\" \\","-X GET"],"syntax":"bash"},{"inlineContent":[{"text":"After that request user is redirected to login page (it it’s not already signed in)","type":"text"},{"text":" ","type":"text"},{"text":"or to authorization page. After authorization redirection to specified ","type":"text"},{"code":"redirect_uri","type":"codeVoice"},{"text":" ","type":"text"},{"text":"is done (with ","type":"text"},{"code":"code","type":"codeVoice"},{"text":" which can be replaced for the access token in token endpoint).","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Authorization endpoint - used by the client to obtain authorization from","type":"text"},{"text":" ","type":"text"},{"text":"the resource owner via user-agent redirection.","type":"text"}],"references":{"doc://VernissageServer/documentation/VernissageServer":{"abstract":[{"text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across","type":"text"},{"text":" ","type":"text"},{"text":"the fediverse - offering powerful features you won’t find anywhere else.","type":"text"}],"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","title":"Vernissage","role":"collection","kind":"symbol","url":"\/documentation\/vernissageserver"},"doc://VernissageServer/documentation/VernissageServer/OAuthController/authenticate(request:)":{"abstract":[{"text":"Authorization endpoint - used by the client to obtain authorization from","type":"text"},{"text":" ","type":"text"},{"text":"the resource owner via user-agent redirection.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController\/authenticate(request:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Request","preciseIdentifier":"s:5Vapor7RequestC","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","preciseIdentifier":"s:5Vapor8ResponseC","kind":"typeIdentifier"}],"title":"authenticate(request:)","url":"\/documentation\/vernissageserver\/oauthcontroller\/authenticate(request:)"},"doc://VernissageServer/documentation/VernissageServer/OAuthController":{"abstract":[{"text":"Controller for OAuth 2.0 endpoints.","type":"text"}],"title":"OAuthController","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/Verniss