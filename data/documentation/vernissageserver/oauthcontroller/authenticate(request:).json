{"abstract":[{"text":"Authorization endpoint - used by the client to obtain authorization from","type":"text"},{"text":" ","type":"text"},{"text":"the resource owner via user-agent redirection.","type":"text"}],"identifier":{"url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController\/authenticate(request:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController"]]},"variants":[{"paths":["\/documentation\/vernissageserver\/oauthcontroller\/authenticate(request:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"Vernissage"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Vapor7RequestC","text":"Request"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Vapor8ResponseC","text":"Response"}],"title":"authenticate(request:)","externalID":"s:16VernissageServer15OAuthControllerV12authenticate7request5Vapor8ResponseCAF7RequestC_tYaYbKF","role":"symbol"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Vapor7RequestC","text":"Request"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:5Vapor8ResponseC","text":"Response"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The authorization endpoint is used to interact with the resource"},{"type":"text","text":" "},{"type":"text","text":"owner and obtain an authorization grant.  The authorization server"},{"type":"text","text":" "},{"type":"text","text":"MUST first verify the identity of the resource owner.  The way in"},{"type":"text","text":" "},{"type":"text","text":"which the authorization server authenticates the resource owner"},{"type":"text","text":" "},{"type":"text","text":"(e.g., username and password login, session cookies) is beyond the"},{"type":"text","text":" "},{"type":"text","text":"scope of this specification."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For example, the client directs the user-agent to make the following"},{"type":"text","text":" "},{"type":"text","text":"HTTP request using TLS:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"CURL request:"}]}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["curl \"https:\/\/example.com\/api\/v1\/oauth\/authorize?response_type=code&client_id=s6BhdRkqt3&state=xyz&redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb\" \\","-X GET"]},{"inlineContent":[{"type":"text","text":"After that request user is redirected to login page (it it’s not already signed in)"},{"type":"text","text":" "},{"type":"text","text":"or to authorization page. After authorization redirection to specified "},{"type":"codeVoice","code":"redirect_uri"},{"type":"text","text":" "},{"type":"text","text":"is done (with "},{"type":"codeVoice","code":"code"},{"type":"text","text":" which can be replaced for the access token in token endpoint)."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"symbol","references":{"doc://VernissageServer/documentation/VernissageServer":{"title":"Vernissage","kind":"symbol","url":"\/documentation\/vernissageserver","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","abstract":[{"text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the fediverse - offering powerful features you won’t find anywhere else."}],"type":"topic","role":"collection"},"doc://VernissageServer/documentation/VernissageServer/OAuthController/authenticate(request:)":{"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController\/authenticate(request:)","title":"authenticate(request:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"authenticate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"request","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Request","preciseIdentifier":"s:5Vapor7RequestC","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Response","preciseIdentifier":"s:5Vapor8ResponseC","kind":"typeIdentifier"}],"abstract":[{"text":"Authorization endpoint - used by the client to obtain authorization from","type":"text"},{"text":" ","type":"text"},{"text":"the resource owner via user-agent redirection.","type":"text"}],"kind":"symbol","url":"\/documentation\/vernissageserver\/oauthcontroller\/authenticate(request:)"},"doc://VernissageServer/documentation/VernissageServer/OAuthController":{"kind":"symbol","abstract":[{"text":"Controller for OAuth 2.0 endpoints.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"OAuthController"}],"iden