 ","type":"text"},{"text":"which the authorization server authenticates the resource owner","type":"text"},{"text":" ","type":"text"},{"text":"(e.g., username and password login, session cookies) is beyond the","type":"text"},{"text":" ","type":"text"},{"text":"scope of this specification.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For example, the client directs the user-agent to make the following","type":"text"},{"text":" ","type":"text"},{"text":"HTTP request using TLS:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"CURL request:"}],"type":"strong"}]},{"syntax":"bash","code":["curl \"https:\/\/example.com\/api\/v1\/oauth\/authorize?response_type=code&client_id=s6BhdRkqt3&state=xyz&redirect_uri=https%3A%2F%2Fclient%2Eexample%2Ecom%2Fcb\" \\","-X GET"],"type":"codeListing"},{"inlineContent":[{"text":"After that request user is redirected to login page (it it’s not already signed in)","type":"text"},{"type":"text","text":" "},{"type":"text","text":"or to authorization page. After authorization redirection to specified "},{"code":"redirect_uri","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"is done (with "},{"code":"code","type":"codeVoice"},{"type":"text","text":" which can be replaced for the access token in token endpoint)."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController\/authenticate(request:)"},"abstract":[{"type":"text","text":"Authorization endpoint - used by the client to obtain authorization from"},{"type":"text","text":" "},{"type":"text","text":"the resource owner via user-agent redirection."}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserver\/oauthcontroller\/authenticate(request:)"]}],"references":{"doc://VernissageServer/documentation/VernissageServer":{"type":"topic","title":"Vernissage","url":"\/documentation\/vernissageserver","abstract":[{"text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across","type":"text"},{"text":" ","type":"text"},{"text":"the fediverse - offering powerful features you won’t find anywhere else.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","role":"collection","kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/OAuthController":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"OAuthController"}],"type":"topic","url":"\/documentation\/vernissageserver\/oauthcontroller","title":"OAuthController","abstract":[{"text":"Controller for OAuth 2.0 endpoints.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"OAuthController"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthController"},"doc://VernissageServer/documentation/VernissageServer/OAuthController/authenticate(request:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"authenticate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"request"},{"kind":"text","text":": "},{"preciseIdentifier":"s:5Vapor7RequestC","kind":"typeIdentifier","text":"Request"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:5Vapor8ResponseC","kind":"typeIdentifier","text":"Response"}],"title":"authenticate(request:)","abstract":[{"type":"text","text":"Authorization endpoint - used by the client to obtain authorization from"},{"type":"text","text":" "},{"type":"