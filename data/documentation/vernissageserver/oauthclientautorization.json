{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserver\/oauthclientautorization"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"This guide shows, step-by-step, how to register a client, obtain user consent, and exchange or refresh tokens, complete with sample payloads and code."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Vernissage implements two OAuth-related specifications to enable secure connections from native mobile applications:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc7591"},{"type":"text","text":" - OAuth 2.0 Dynamic Client Registration Protocol"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6749"},{"type":"text","text":" - The OAuth 2.0 Authorization Framework"}]}]}]},{"inlineContent":[{"type":"text","text":"To access Vernissage’s API from a mobile app you will usually perform three high-level steps:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Register a new OAuth client.","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Open","type":"text"}]},{"type":"text","text":" \/api\/v1\/oauth\/authorize "},{"type":"strong","inlineContent":[{"text":"to let the user grant access.","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Exchange","type":"text"}]},{"type":"text","text":" the code returned by that page for an "},{"type":"strong","inlineContent":[{"text":"access token","type":"text"}]},{"type":"text","text":" that you can include in subsequent API requests."}]}]}]},{"inlineContent":[{"type":"text","text":"Each step is described in detail below."}],"type":"paragraph"},{"type":"thematicBreak"},{"anchor":"1-Registering-an-OAuth-client","type":"heading","level":2,"text":"1. Registering an OAuth client"},{"inlineContent":[{"type":"text","text":"An "},{"isActive":true,"identifier":"AuthenticationDynamicClientsController\/register(request:)","type":"reference"},{"type":"text","text":" has been added for creating the OAuth client: "},{"code":"POST \/api\/v1\/auth-dynamic-clients","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This endpoint implements "},{"isActive":true,"overridingTitle":"RFC 7591","identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc7591","type":"reference","overridingTitleInlineContent":[{"type":"text","text":"RFC 7591"}]},{"type":"text","text":", so the full set of parameters and error codes can be found in that document."},{"type":"text","text":" "},{"type":"text","text":"Below is a minimal example payload (replace the placeholder values with those of your own application):"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"client_name\": \"My Mobile App\",","  \"client_uri\": \"https:\/\/mymobileapp.org\/\",","  \"contacts\": [\"info@mymobileapp.org\"],","  \"grant_types\": [\"authorization_code\", \"refresh_token\"],","  \"redirect_uris\": [\"mymobileapp-app:\/\/oauth-callback\/mymobileapp\"],","  \"response_types\": [\"code\"],","  \"scope\": \"read write profile\",","  \"software_id\": \"da886f55-bf4e-4d6d-af0a-ad2f4d59e4d6\",","  \"software_version\": \"1.0.0\"","}"]},{"inlineContent":[{"type":"text","text":"In the example we request an OAuth client that supports two grant types ("},{"code":"authorization_code","type":"codeVoice"},{"type":"text","text":", "},{"code":"refresh_token","type":"codeVoice"},{"type":"text","text":") and one response type ("},{"code":"code","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Public vs. confidential clients"}]}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you need a confidential client (i.e. one with a client secret), include the optional "},{"code":"token_endpoint_auth_method","type":"codeVoice"},{"type":"text","text":" parameter:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"none"},{"type":"text","text":" (default)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Public client - no client secret (OAuth 2.0 § 2.1)."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"client_secret_post"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confidential client - sends "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" + "},{"type":"codeVoice","code":"client_secret"},{"type":"text","text":" in the request body (OAuth 2.0 § 2.3.1)."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"client_secret_basic"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confidential client - uses HTTP Basic auth (OAuth 2.0 § 2.3.1). Currently not supported."}]}]]]},{"inlineContent":[{"type":"text","text":"When you request a confidential client, Vernissage returns both a "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"client_secret","type":"codeVoice"},{"type":"text","text":". After sending the request shown above, the response contains exactly the same fields we sent, along with a few additional ones. The most important of these is "},{"code":"client_id","type":"codeVoice"},{"type":"text","text":", and we will need its value later."}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"client_id\": \"7518093054805281088\",","  \"client_id_issued_at\": 1750442445,","  \"client_name\": \"My Mobile App\",","  \"client_uri\": \"https:\/\/mymobileapp.org\/\",","  \"contacts\": [\"info@mymobileapp.org\"],","  \"grant_types\": [\"authorization_code\", \"refresh_token\"],","  \"redirect_uris\": [\"mymobileapp-app:\/\/oauth-callback\/mymobileapp\"],","  \"response_types\": [\"code\"],","  \"scope\": \"read write profile\",","  \"software_id\": \"da886f55-bf4e-4d6d-af0a-ad2f4d59e4d6\",","  \"software_version\": \"1.0.0\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Store the "},{"type":"codeVoice","code":"client_id"},{"type":"text","text":" (and "},{"type":"codeVoice","code":"client_secret"},{"type":"text","text":", if provided) securely in your app and reuse them for all future log-in attempts - you do not need to register a new client every time."}]},{"type":"heading","level":2,"anchor":"2-Requesting-user-authorization","text":"2. Requesting user authorization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the client is registered, open the authorization page in the system browser or an authentication session. Below is a snippet of code from an iOS application (SwiftUI) that performs exactly this task."}]},{"type":"codeListing","code":["@Environment(\\.webAuthenticationSession) private var webAuthenticationSession","","\/\/ 1. (Optional) Create a client as shown above.","","\/\/ 2. Authorize the user.","let url = \"https:\/\/vernissage.instance\/api\/v1\/oauth\/authorize?\" +","    \"response_type=code\" + ","    \"&client_id=7518093054805281088\" +","    \"&redirect_uri=mymobileapp-app:\/\/oauth-callback\/mymobileapp\" +","    \"&state=c268e3d2-73a1-4af4-ba4b-9634f8fff367\" +","    \"&scope=read write profile\"","","let callbackURL = try await webAuthenticationSession.authenticate(","    using: URL(string: url)!,","    callbackURLScheme: \"mymobileapp-app\"",")","","let queryItems = URLComponents(string: callbackURL.absoluteString)?.queryItems","let code = queryItems?.first { $0.name == \"code\" }?.value"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The action above will display a login screen if the user is not already logged in. After logging in, the user will be redirected to a page where they must confirm that they want to authorize the application to access their data. If the user is already logged in, the authorization page is shown immediately."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the user authorizes access, the browser redirects the request to the URL defined in the "},{"type":"codeVoice","code":"redirect_uri"},{"type":"text","text":". This URL also includes a "},{"type":"codeVoice","code":"code"},{"type":"text","text":" parameter, which can be exchanged for an access token."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Special "},{"type":"codeVoice","code":"redirect_uri"},{"type":"text","text":" parameter - "},{"type":"codeVoice","code":"urn:ietf:wg:oauth:2.0:oob"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If "},{"type":"codeVoice","code":"redirect_uri"},{"type":"text","text":" parameter is set to "},{"type":"codeVoice","code":"urn:ietf:wg:oauth:2.0:oob"},{"type":"text","text":" then the authorization "},{"type":"codeVoice","code":"code"},{"type":"text","text":" will be returned in the response instead of creating redirection to the client address. That kind of return URI must match one of the "},{"type":"codeVoice","code":"redirect_uris"},{"type":"text","text":" declared during app registration."}]},{"type":"heading","level":2,"anchor":"3-Exchanging-the-authorization-code-for-an-access-token","text":"3. Exchanging the authorization code for an access token"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once we have the "},{"type":"codeVoice","code":"code"},{"type":"text","text":", we can exchange it for an "},{"type":"codeVoice","code":"access token"},{"type":"text","text":", which can then be used in subsequent API requests (in the header: "},{"type":"codeVoice","code":"Authorization: Bearer ..."},{"type":"text","text":"). To do this, we need to send a "},{"type":"codeVoice","code":"POST"},{"type":"text","text":" request to the "},{"type":"codeVoice","code":"\/api\/v1\/oauth\/token"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"OAuthController\/token(request:)"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"Request headers:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Content-Type: application\/x-www-form-urlencoded"]},{"inlineContent":[{"type":"text","text":"Request body:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["grant_type=authorization_code&client_id=7518093054805281088&code=hgnbf9yrjmgjhe87yjwetrhfnb874yrk&redirect_uri=mymobileapp-app:\/\/oauth-callback\/mymobileapp"]},{"inlineContent":[{"type":"text","text":"This request will return a JSON response like the one shown below."}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"access_token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzUxMiJ9.eyJpZC...\",","  \"token_type\": \"bearer\",","  \"expires_in\": \"2025-06-27T20:08:41.510Z\",","  \"refresh_token\": \"qsqyUKLjmjhRrr4rUa9vtDX71eRdSCYN7DCiLPlo\"","}"]},{"inlineContent":[{"type":"text","text":"With these few steps, we have obtained an access token valid for 7 days, and a refresh token valid for 30 days. Include the access token in subsequent API calls: "},{"code":"Authorization: Bearer <access_token>","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Refreshing-an-access-token","type":"heading","level":3,"text":"Refreshing an access token"},{"inlineContent":[{"type":"text","text":"It’s a good practice to implement the application in a way that refreshes the access token before it expires (i.e., before the 7-day period ends), using the same endpoint. To do this, we need to send a request to "},{"code":"\/api\/v1\/oauth\/token","type":"codeVoice"},{"type":"text","text":" with the following parameters:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Request headers:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Content-Type: application\/x-www-form-urlencoded"]},{"inlineContent":[{"type":"text","text":"Request body:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["grant_type=refresh_token&client_id=7518093054805281088&refresh_token=qsqyUKLjmjhRrr4rUa9vtDX71eRdSCYN7DCiLPlo"]},{"inlineContent":[{"type":"text","text":"This request will return a JSON response containing a new access token and a new refresh token."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"metadata":{"role":"article","roleHeading":"Article","title":"Using OAuth with Vernissage","modules":[{"name":"Vernissage"}]},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthClientAutorization","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds"],"generated":true}],"references":{"doc://VernissageServer/documentation/VernissageServer/HostVernissageWeb":{"title":"Host Vernissage WEB","abstract":[{"type":"text","text":"Application which is Web component for Vernissage photos sharing platform."}],"images":[{"type":"card","identifier":"host-web-card.jpg"}],"url":"\/documentation\/vernissageserver\/hostvernissageweb","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","kind":"article"},"doc://VernissageServer/documentation/VernissageServer":{"type":"topic","title":"Vernissage","url":"\/documentation\/vernissageserver","abstract":[{"text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across","type":"text"},{"text":" ","type":"text"},{"text":"the fediverse - offering powerful features you won’t find anywhere else.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","role":"collection","kind":"symbol"},"https://datatracker.ietf.org/doc/html/rfc7591":{"type":"link","title":"RFC 7591","titleInlineContent":[{"type":"text","text":"RFC 7591"}],"url":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc7591","identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc7591"},"doc://VernissageServer/documentation/VernissageServer/ActivityPub":{"title":"ActivityPub","abstract":[{"type":"text","text":"A decentralized social networking protocol based upon the ActivityStreams 2.0 data format and JSON-LD."}],"url":"\/documentation\/vernissageserver\/activitypub","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","kind":"article"},"host-server-card.jpg":{"type":"image","variants":[{"url":"\/images\/VernissageServer\/host-server-card@2x.jpg","traits":["2x","light"]}],"alt":"The profile image for server documentation.","identifier":"host-server-card.jpg"},"doc://VernissageServer/documentation/VernissageServer/WebFinger":{"title":"WebFinger","abstract":[{"type":"text","text":"WebFinger translates "},{"type":"codeVoice","code":"@user@domain"},{"type":"text","text":" into its ActivityPub actor URL."}],"url":"\/documentation\/vernissageserver\/webfinger","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","kind":"article"},"OAuthController/token(request:)":{"type":"link","title":"endpoint","titleInlineContent":[{"type":"text","text":"endpoint"}],"url":"OAuthController\/token(request:)","identifier":"OAuthController\/token(request:)"},"doc://VernissageServer/documentation/VernissageServer/ContentFeeds":{"title":"Content feeds (RSS\/Atom)","abstract":[{"type":"strong","inlineContent":[{"text":"RSS","type":"text"}]},{"type":"text","text":" (Really Simple Syndication) and "},{"type":"strong","inlineContent":[{"text":"Atom","type":"text"}]},{"type":"text","text":" are widely used web feed formats that allow users to subscribe to updates from websites in an organized and automated way. These protocols enable seamless content consumption through feed readers, making it easier to stay up to date with new posts, images, and other shared content without manually visiting a website."}],"url":"\/documentation\/vernissageserver\/contentfeeds","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds","kind":"article"},"doc://VernissageServer/documentation/VernissageServer/BuildDocumentation":{"type":"topic","url":"\/documentation\/vernissageserver\/builddocumentation","kind":"article","title":"Build the documentation","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","abstract":[{"type":"text","text":"This documentation is created by DocC tool."}]},"doc://VernissageServer/documentation/VernissageServer/HttpSecurity":{"title":"Http security","abstract":[{"type":"text","text":"Remote request verification."}],"url":"\/documentation\/vernissageserver\/httpsecurity","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity","kind":"article"},"host-web-card.jpg":{"identifier":"host-web-card.jpg","variants":[{"url":"\/images\/VernissageServer\/host-web-card@2x.jpg","traits":["2x","light"]}],"type":"image","alt":"The profile image for web documentation."},"https://datatracker.ietf.org/doc/html/rfc6749":{"identifier":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6749","title":"RFC 6749","titleInlineContent":[{"type":"text","text":"RFC 6749"}],"type":"link","url":"https:\/\/datatracker.ietf.org\/doc\/html\/rfc6749"},"doc://VernissageServer/documentation/VernissageServer/HostVernissageServer":{"title":"Host Vernissage Server (API)","abstract":[{"type":"text","text":"Application which is main API component for Vernissage photos sharing platform."}],"images":[{"type":"card","identifier":"host-server-card.jpg"}],"url":"\/documentation\/vernissageserver\/hostvernissageserver","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","kind":"article"},"doc://VernissageServer/documentation/VernissageServer/DockerContainers":{"title":"Hosting Vernissage in Docker containers","abstract":[{"type":"text","text":"This documentation describes how to run Vernissage in your custom Docker container hosting provider using "},{"type":"codeVoice","code":"docker compose"},{"type":"text","text":"."}],"url":"\/documentation\/vernissageserver\/dockercontainers","type":"topic","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","kind":"article"},"AuthenticationDynamicClientsController/register(request:)":{"type":"link","url":"AuthenticationDynamicClientsController\/register(request:)","title":"endpoint","titleInlineContent":[{"text":"endpoint","type":"text"}],"identifier":"AuthenticationDynamicClientsController\/register(request:)"}}}