nt":[{"text":"Embedded ICC profile from the source file is not retained.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Practical result: output JPEGs are interpreted as sRGB by typical clients (browsers\/OS viewers), but they do not carry the original embedded ICC profile.","type":"text"}]}]}]},{"level":2,"text":"HDR upload","anchor":"HDR-upload","type":"heading"},{"inlineContent":[{"type":"text","text":"Action: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AttachmentsController\/uploadHdr(request:)"}],"type":"paragraph"},{"type":"heading","text":"Accepted input","anchor":"Accepted-input","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Requires an existing attachment owned by the authenticated user."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum HDR file size: "},{"type":"codeVoice","code":"4_194_304"},{"type":"text","text":" bytes."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Only ","type":"text"},{"type":"codeVoice","code":"avif"},{"type":"text","text":" extension is accepted."}]}]}]},{"level":3,"text":"Processing pipeline","anchor":"Processing-pipeline","type":"heading"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The uploaded AVIF file is written to a temporary location.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The file is saved to storage as ","type":"text"},{"type":"codeVoice","code":"originalHdrFile"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No decode, rotate, resize, or re-encode step is performed.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"originalHdrFile","type":"codeVoice"},{"text":" is attached in the database.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineCon