"codeVoice"},{"type":"text","text":" bytes)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Supported input extensions: "},{"type":"codeVoice","code":"jpg"},{"type":"text","text":", "},{"type":"codeVoice","code":"jpeg"},{"type":"text","text":", "},{"type":"codeVoice","code":"png"},{"type":"text","text":", "},{"type":"codeVoice","code":"webp"},{"type":"text","text":"."}]}]}]},{"level":3,"text":"Processing pipeline","anchor":"Processing-pipeline","type":"heading"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The uploaded file is written to a temporary location."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The image is decoded in memory ("},{"type":"codeVoice","code":"SwiftGD.Image"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"EXIF "},{"type":"codeVoice","code":"Orientation"},{"type":"text","text":" is read and the image is rotated accordingly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Vernissage “original” file is produced:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the rotated image is exported to JPEG,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"export creates a new image stream ("},{"code":"gdImageJpeg","type":"codeVoice"},{"type":"text","text":"),"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"source metadata (including EXIF and embedded ICC profile) is not preserved."}]}]}],"type":"unorderedList"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The Vernissage “small” file is produced:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"based on the rotated image,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"resized to width "},{"code":"800 px","typ