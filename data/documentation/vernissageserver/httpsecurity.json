geServer/WebFinger":{"role":"article","url":"\/documentation\/vernissageserver\/webfinger","kind":"article","title":"WebFinger","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","type":"topic","abstract":[{"text":"WebFinger translates ","type":"text"},{"code":"@user@domain","type":"codeVoice"},{"text":" into its ActivityPub actor URL.","type":"text"}]},"doc://VernissageServer/documentation/VernissageServer/DockerContainers":{"role":"article","url":"\/documentation\/vernissageserver\/dockercontainers","kind":"article","title":"Hosting Vernissage in Docker containers","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","type":"topic","abstract":[{"type":"text","text":"This documentation describes how to run Vernissage in your custom Docker container hosting provider using "},{"code":"docker compose","type":"codeVoice"},{"type":"text","text":"."}]}}}