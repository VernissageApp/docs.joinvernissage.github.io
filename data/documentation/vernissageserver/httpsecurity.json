{"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity"},"metadata":{"role":"article","title":"Http security","modules":[{"name":"Vernissage"}],"roleHeading":"Article"},"abstract":[{"text":"Remote request verification.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Vernissage authenticates every ActivityPub request with exactly the same HTTP Signature scheme that Mastodon describes in its security specification. Each inbound request must include a "},{"type":"codeVoice","code":"Signature"},{"type":"text","text":" header that:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"points to the sender’s public key with keyId,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"lists the headers that were signed (commonly (request-target) host date digest), and","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"contains a Base-64-encoded RSA-SHA256 signature of those header values.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"When Vernissage receives the request it reconstructs the signed string, fetches the public key referenced by keyId, and verifies the signature. For POST requests it additionally checks the ","type":"text"},{"code":"Digest","type":"codeVoice"},{"text":" header against the body and rejects any message whose ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" header is older than 12 hours, ensuring both authenticity and integrity of the message.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the full description in Mastodon’s documentation: ","type":"text"},{"identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/vernissageserver\/httpsecurity"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","references":{"doc://VernissageServer/documentation/VernissageServer/HostVernissageWeb":{"kind":"article","type":"topic","images":[{"type":"card","identifier":"host-web-card.jpg"}],"role":"article","url":"\/documentation\/vernissageserver\/hostvernissageweb","abstract":[{"text":"Application which is Web component for Vernissage photos sharing platform.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","title":"Host Vernissage WEB"},"https://docs.joinmastodon.org/spec/security/#http":{"type":"link","identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","titleInlineContent":[{"type":"text","text":"Mastodon Security — HTTP Signatures"}],"url":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","title":"Mastodon Security — HTTP Signatures"},"doc://VernissageServer/documentation/VernissageServer/ContentFeeds":{"type":"topic","title":"Content feeds (RSS\/Atom)","abstract":[{"inlineContent":[{"type":"text","text":"RSS"}],"type":"strong"},{"text":" (Really Simple Syndication) and ","type":"text"},{"inlineContent":[{"type":"text","text":"Atom"}],"type":"strong"},{"text":" are widely used web feed formats that allow users to subscribe to updates from websites in an organized and automated way. These protocols enable seamless content consumption through feed readers, making it easier to stay up to date with new posts, images, and other shared content without manually visiting a website.","type":"text"}],"role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds","kind":"article","url":"\/documentation\/vernissageserver\/contentfeeds"},"doc://VernissageServer/documentation/VernissageServer/ActivityPub":{"role":"article","url":"\/documentation\/vernissageserver\/activitypub","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","kind":"article","type":"topic","title":"ActivityPub","abstract":[{"type":"text","text":"A decentralized social networking protocol based upon the ActivityStreams 2.0 data format and JSON-LD."}]},"doc://VernissageServer/documentation/VernissageServer/DockerContainers":{"type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","url":"\/documentation\/vernissageserver\/dockercontainers","title":"Hosting Vernissage in Docker containers","role":"article","abstract":[{"type":"text","text":"This documentation describes how to run Vernissage in your custom Docker container hosting provider using "},{"type":"codeVoice","code":"docker compose"},{"type":"text","text":"."}],"kind":"article"},"doc://VernissageServer/documentation/VernissageServer/BuildDocumentation":{"abstract":[{"text":"This documentation is created by DocC tool.","type":"text"}],"url":"\/documentation\/vernissageserver\/builddocumentation","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","title":"Build the documentation","role":"article","kind":"article","type":"topic"},"doc://VernissageServer/documentation/Vernissag