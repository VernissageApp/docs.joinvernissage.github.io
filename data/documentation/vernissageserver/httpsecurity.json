{"abstract":[{"type":"text","text":"Remote request verification."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Vernissage authenticates every ActivityPub request with exactly the same HTTP Signature scheme that Mastodon describes in its security specification. Each inbound request must include a "},{"type":"codeVoice","code":"Signature"},{"type":"text","text":" header that:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"points to the sender’s public key with keyId,"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"lists the headers that were signed (commonly (request-target) host date digest), and","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"contains a Base-64-encoded RSA-SHA256 signature of those header values.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"When Vernissage receives the request it reconstructs the signed string, fetches the public key referenced by keyId, and verifies the signature. For POST requests it additionally checks the "},{"type":"codeVoice","code":"Digest"},{"type":"text","text":" header against the body and rejects any message whose "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" header is older than 12 hours, ensuring both authenticity and integrity of the message."}],"type":"paragraph"},{"inlineContent":[{"text":"See the full description in Mastodon’s documentation: ","type":"text"},{"isActive":true,"identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds"],"anchor":"Essentials","generated":true,"title":"Essentials"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserver\/httpsecurity"]}],"kind":"article","metadata":{"modules":[{"name":"Vernissage"}],"roleHeading":"Article","role":"article","title":"Http security"},"references":{"host-web-card.jpg":{"identifier":"host-web-card.jpg","variants":[{"url":"\/images\/VernissageServer\/host-web-card@2x.jpg","traits":["2x","light"]}],"type":"image","alt":"The profile image for web documentation."},"doc://VernissageServer/documentation/VernissageServer/DockerContainers":{"abstract":[{"text":"This documentation describes how to run Vernissage in your custom Docker container hosting provider using ","type":"text"},{"code":"docker compose","type":"codeVoice"},{"text":".","type":"text"}],"title":"Hosting Vernissage in Docker containers","url":"\/documentation\/vernissageserver\/dockercontainers","kind":"article","role":"article","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers"},"doc://VernissageServer/documentation/VernissageServer/WebFinger":{"abstract":[{"type":"text","text":"WebFinger translates "},{"type":"codeVoice","code":"@user@domain"},{"type":"text","text":" into its ActivityPub actor URL."}],"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","title":"WebFinger","url":"\/documentation\/vernissageserver\/webfinger"},"doc://VernissageServer/documentation/VernissageServer":{"title":"Vernissage","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/vernissageserver","abstract":[{"type":"text","text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across"},{"type":"text","text":" "},{"type":"text","text":"the fediverse - offering powerful features you won’t find anywhere else."}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer"},"doc://VernissageServer/documentation/VernissageServer/ContentFeeds":{"url":"\/documentation\/vernissageserver\/contentfeeds","kind":"article","role":"article","abstract":[{"inlineContent":[{"type":"text","text":"RSS"}],"type":"strong"},{"text":" (Really Simple Syndication) and ","type":"text"},{"inlineContent":[{"text":"Atom","type":"text"}],"type":"strong"},{"text":" are widely used web feed formats that allow users to subscribe to updates from websites in an organized and automated way. These protocols enable seamless content consumption through feed readers, making it easier to stay up to date with new posts, images, and other shared content without manually visiting a website.","type":"text"}],"type":"topic","title":"Content feeds (RSS\/Atom)","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds"},"doc://VernissageServer/documentation/VernissageServer/ActivityPub":{"abstract":[{"text":"A decentralized social networking protocol based upon the ActivityStreams 2.0 data format and JSON-LD.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","title":"ActivityPub","role":"article","kind":"article","type":"topic","url":"\/documentation\/vernissageserver\/activitypub"},"doc://VernissageServer/documentation/VernissageServer/BuildDocumentation":{"role":"article","url":"\/documentation\/vernissageserver\/builddocumentation","kind":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","abstract":[{"text":"This documentation is created by DocC tool.","type":"text"}],"type":"topic","title":"Build the documentation"},"doc://VernissageServer/documentation/VernissageServer/HostVernissageWeb":{"url":"\/documentation\/vernissageserver\/hostvernissageweb","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","title":"Host Vernissage WEB","role":"article","kind":"article","images":[{"type":"card","identifier":"host-web-card.jpg"}],"type":"topic","abstract":[{"text":"Application which is Web component for Vernissage photos sharing platform.","type":"text"}]},"doc://VernissageServer/documentation/VernissageServer/HostVernissageServer":{"kind":"article","title":"Host Vernissage Server (API)","role":"article","url":"\/documentation\/vernissageserver\/hostvernissageserver","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","type":"topic","abstract":[{"type":"text","text":"Application which is main API component for Vernissage photos sharing platform."}],"images":[{"identifier":"host-server-card.jpg","type":"card"}]},"host-server-card.jpg":{"identifier":"host-server-card.jpg","variants":[{"traits":["2x","light"],"url":"\/images\/VernissageServer\/host-server-card@2x.jpg"}],"type":"image","alt":"The profile image for server documentation."},"https://docs.joinmastodon.org/spec/security/#http":{"url":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","title":"Mastodon Security — HTTP Signatures","type":"link","titleInlineContent":[{"type":"text","text":"Mastodon Security — HTTP Signatures"}]}}}