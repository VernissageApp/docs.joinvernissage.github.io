{"abstract":[{"text":"Remote request verification.","type":"text"}],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthClientAutorization","doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ColorProfiles"],"generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/vernissageserver\/httpsecurity"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vernissage authenticates every ActivityPub request with exactly the same HTTP Signature scheme that Mastodon describes in its security specification. Each inbound request must include a "},{"type":"codeVoice","code":"Signature"},{"type":"text","text":" header that:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"points to the sender’s public key with keyId,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"lists the headers that were signed (commonly (request-target) host date digest), and"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"contains a Base-64-encoded RSA-SHA256 signature of those header values."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When Vernissage receives the request it reconstructs the signed string, fetches the public key referenced by keyId, and verifies the signature. For POST requests it additionally checks the "},{"type":"codeVoice","code":"Digest"},{"type":"text","text":" header against the body and rejects any message whose "},{"type":"codeVoice","code":"Date"},{"type":"text","text":" header is older than 12 hours, ensuring both authenticity and integrity of the message."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the full description in Mastodon’s documentation: "},{"identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"kind":"article","sections":[],"metadata":{"title":"Http security","modules":[{"name":"Vernissage"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"references":{"doc://VernissageServer/documentation/VernissageServer":{"abstract":[{"type":"text","text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across"},{"text":" ","type":"text"},{"text":"the fediverse - offering powerful features you won’t find anywhere else.","type":"text"}],"title":"Vernissage","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","kind":"symbol","url":"\/documentation\/vernissageserver","type":"topic","role":"collection"},"doc://VernissageServer/documentation/VernissageServer/OAuthClientAutorization":{"role":"article","url":"\/documentation\/vernissageserver\/oauthclientautorization","kind":"article","title":"Using OAuth with Vernissage","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthClientAutorization","type":"topic","abstract":[{"text":"This guide shows, step-by-step, how to register a client, obtain user consent, and exchange or refresh tokens, complete with sample payloads and code.","type":"text"}]},"https://docs.joinmastodon.org/spec/security/#http":{"title":"Mastodon Security — HTTP Signatures","type":"link","titleInlineContent":[{"type":"text","text":"Mastodon Security — HTTP Signatures"}],"identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","url":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http"},"doc://VernissageServer/documentation/VernissageServer/ContentFeeds":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds","title":"Content feeds (RSS\/Atom)","kind":"article","abstract":[{"inlineContent":[{"type":"text","text":"RSS"}],"type":"strong"},{"text":" (Really Simple Syndication) and ","type":"text"},{"inlineContent":[{"type":"text","text":"Atom"}],"type":"strong"},{"text":" are widely used web feed formats that allow users to subscribe to updates from websites in an organized and automated way. These protocols enable seamless content consumption through feed readers, making it easier to stay up to date with new posts, images, and other shared content without manually visiting a website.","type":"text"}],"role":"article","url":"\/documentation\/vernissageserver\/contentfeeds","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/HostVernissageServer":{"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","kind":"article","title":"Host Vernissage Server (API)","images":[{"identifier":"host-server-card.jpg","type":"card"}],"abstract":[{"type":"text","text":"Application which is main API component for Vernissage photos sharing platform."}],"role":"article","url":"\/documentation\/vernissageserver\/hostvernissageserver","type":"topic"},"doc://VernissageServer/documentation/VernissageServer/ColorProfiles":{"abstract":[{"text":"This document describes the current behavior of two endpoints:","type":"text"}],"identifi