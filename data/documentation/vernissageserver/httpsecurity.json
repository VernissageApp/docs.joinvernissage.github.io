{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"inlineContent":[{"text":"Vernissage authenticates every ActivityPub request with exactly the same HTTP Signature scheme that Mastodon describes in its security specification. Each inbound request must include a ","type":"text"},{"code":"Signature","type":"codeVoice"},{"text":" header that:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"points to the sender’s public key with keyId,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"lists the headers that were signed (commonly (request-target) host date digest), and"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"contains a Base-64-encoded RSA-SHA256 signature of those header values."}]}]}]},{"inlineContent":[{"text":"When Vernissage receives the request it reconstructs the signed string, fetches the public key referenced by keyId, and verifies the signature. For POST requests it additionally checks the ","type":"text"},{"code":"Digest","type":"codeVoice"},{"text":" header against the body and rejects any message whose ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" header is older than 12 hours, ensuring both authenticity and integrity of the message.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"See the full description in Mastodon’s documentation: ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/vernissageserver\/httpsecurity"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Remote request verification.","type":"text"}],"kind":"article","seeAlsoSections":[{"anchor":"Essentials","identifie