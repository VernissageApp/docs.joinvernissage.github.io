type":"paragraph","inlineContent":[{"text":"lists the headers that were signed (commonly (request-target) host date digest), and","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"contains a Base-64-encoded RSA-SHA256 signature of those header values.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When Vernissage receives the request it reconstructs the signed string, fetches the public key referenced by keyId, and verifies the signature. For POST requests it additionally checks the ","type":"text"},{"code":"Digest","type":"codeVoice"},{"text":" header against the body and rejects any message whose ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":" header is older than 12 hours, ensuring both authenticity and integrity of the message.","type":"text"}]},{"inlineContent":[{"text":"See the full description in Mastodon’s documentation: ","type":"text"},{"isActive":true,"identifier":"https:\/\/docs.joinmastodon.org\/spec\/security\/#http","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"host-server-card.jpg":{"identifier":"host-server-card.jpg","variants":[{"url":"\/images\/VernissageServer\/host-server-card@2x.jpg","traits":["2x","light"]}],"alt":"The profile image for server documentation.","type":"image"},"doc://VernissageServer/documentation/VernissageServer/ColorProfiles":{"type":"topic","kind":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ColorProfiles","url":"\/documentation\/vernissageserver\/colorprofiles","title":"Color Profiles","role":"article","abstract":[{"text":"This document describes the current behavior of two endpoints:","type":"text"}]},"doc://VernissageServer/documentation/VernissageServer/WebFinger":{"role":"article","url":"\/documentation\/vernissageserver\/webfinger","kind":"article","title":"WebFinger","abstract":[{"type":"text","text":"WebFinger translates "},{"type":"codeVoice","code":"@user@domain"},{"type":"text