{"identifier":{"url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"abstract":[{"inlineContent":[{"type":"text","text":"RSS"}],"type":"strong"},{"type":"text","text":" (Really Simple Syndication) and "},{"inlineContent":[{"type":"text","text":"Atom"}],"type":"strong"},{"type":"text","text":" are widely used web feed formats that allow users to subscribe to updates from websites in an organized and automated way. These protocols enable seamless content consumption through feed readers, making it easier to stay up to date with new posts, images, and other shared content without manually visiting a website."}],"sections":[],"metadata":{"modules":[{"name":"Vernissage"}],"roleHeading":"Article","title":"Content feeds (RSS\/Atom)","role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageServer","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Vernissage fully supports both "},{"type":"strong","inlineContent":[{"text":"RSS","type":"text"}]},{"type":"text","text":" and "},{"type":"strong","inlineContent":[{"type":"text","text":"Atom"}]},{"type":"text","text":", allowing users to browse various timelines and individual user profiles through compatible feed readers. Each feed provides structured data on the latest activity, ensuring that users can stay engaged with their favorite content effortlessly. Vernissage offers multiple RSS\/Atom endpoints, making it possible to follow specific timelines or curated content easily. The available RSS feeds include:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"User’s feeds","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"\/(rss|atom)\/users\/@{username}","type":"codeVoice"},{"text":" - follow updates from a specific user.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Local timeline","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"\/(rss|atom)\/local"},{"type":"text","text":" - see posts from users within the local instance."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Global timeline","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"\/(rss|atom)\/global","type":"codeVoice"},{"type":"text","text":" - discover content from across the Fediverse network."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Trending posts","type":"text"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"\/(rss|atom)\/trending\/daily","type":"codeVoice"},{"type":"text","text":" - most popular posts of the day."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\/(rss|atom)\/trending\/monthly","type":"codeVoice"},{"type":"text","text":" - most popular posts of the month."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\/(rss|atom)\/trending\/yearly"},{"type":"text","text":" - most popular posts of the year."}]}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Featured posts"}],"type":"strong"},{"type":"text","text":": "},{"code":"\/(rss|atom)\/featured","type":"codeVoice"},{"type":"text","text":" - a selection of highlighted content."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Category feeds"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"\/(rss|atom)\/categories\/{category}"},{"type":"text","text":" - follow posts from a specific category."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Hashtag feeds"}],"type":"strong"},{"type":"text","text":": "},{"code":"\/(rss|atom)\/hashtags\/{hashtag}","type":"codeVoice"},{"type":"text","text":" – stay updated on content using a specific hashtag."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Each Atom\/RSS feeds provides up to 40 recent posts, ensuring users have access to the latest content. The only difference between RSS and Atom feed URLs is the prefix: RSS feeds use ","type":"text"},{"type":"codeVoice","code":"\/rss\/"},{"text":", while Atom feeds use ","type":"text"},{"type":"codeVoice","code":"\/atom\/"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/vernissageserver\/contentfeeds"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://VernissageServer/documentation/VernissageServer/ActivityPub":{"type":"topic","title":"ActivityPub","kind":"article","abstract":[{"type":"emphasis","inlineContent":[{"text":"Work in progress…","type":"text"}]}],"url":"\/documentation\/vernissageserver\/activitypub","role":"article","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub"},"doc://VernissageServer/documentation/VernissageServer/DockerContainers":{"abstract":[{"type":"text","text":"This documentation describes how to run Vernissage in your custom Docker container hosting provider using "},{"ty