sTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"MaxAge","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"public","type":"codeVoice"},{"type":"text","text":" directive is included in a server’s HTTP response to indicate that it can be stored in a shared cache."},{"type":"text","text":" "},{"type":"text","text":"Caches are not permitted to store HTTP responses that contain the HTTP Authorization header unless they are accompanied by the public directive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"max-age"},{"type":"text","text":" directive is sent by a server to indicate that the HTTP response will remain fresh for a specified number of seconds after it is generated."},{"text":" ","type":"text"},{"text":"Essentially, it informs caches how long it will remain fresh. Importantly, the number of seconds indicates the period from which the content was generated,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as opposed to received. This means that any time spent in transit or stored in the caches of intermediaries is deducted from the allowance."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"immutable","type":"codeVoice"},{"type":"text","text":" directive indicates a guarantee by the server that the HTTP response will not be updated while it is still fresh."},{"type":"text","text":" "},{"type":"text","text":"This can be used to avoid unnecessary conditional HTTP requests"}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"identifier":{"url":"doc:\/\/VernissageServer