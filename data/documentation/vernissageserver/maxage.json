{"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"abstract":[{"text":"Max-Age cache setting for static centent served by S3 CDN: https:\/\/http.dev\/cache-control.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/day","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/month","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/week","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/year"],"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/init(rawValue:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/Equatable-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/RawRepresentable-Implementations"],"generated":true,"anchor":"Default-Implementations","title":"Default Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaxAge"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"public","type":"codeVoice"},{"type":"text","text":" directive is included in a server’s HTTP response to indicate that it can be stored in a shared cache."},{"type":"text","text":" "},{"type":"text","text":"Caches are not permitted to store HTTP responses that contain the HTTP Authorization header unless they are accompanied by the public directive."}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"max-age","type":"codeVoice"},{"text":" directive is sent by a server to indicate that the HTTP response will remain fresh for a specified number of seconds after it is generated.","type":"text"},{"text":" ","type":"text"},{"text":"Essentially, it informs caches how long it will remain fresh. Importantly, the number of seconds indicates the period from which the content was generated,","type":"text"},{"text":" ","type":"text"},{"text":"as opposed to received. This means that any time spent in transit or stored in the caches of intermediaries is deducted from the allowance.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"immutable","type":"codeVoice"},{"text":" directive indicates a guarantee by the server that the HTTP response will not be updated while it is still fresh.","type":"text"},{"text":" ","type":"text"},{"text":"This can be used to avoid unnecessary conditional HTTP requests","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/vernissageserver\/maxage"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"text":"MaxAge","kind":"identifier"}],"roleHeading":"Enumeration","role":"symbol","modules":[{"name":"Vernissage"}],"externalID":"s:16VernissageServer6MaxAgeO","title":"MaxAge","symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaxAge","kind":"identifier"}]},"kind":"symbol","sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/AccessTokens","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ApplicationSettings","doc:\/\/VernissageServer\/documentation\/VernissageServer\/Attachment","doc:\/\/VernissageServer\/documentation\/VernissageServer\/Article","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfo","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleRead","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleVisibility","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleVisibili