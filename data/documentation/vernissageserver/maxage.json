{"metadata":{"roleHeading":"Enumeration","role":"symbol","title":"MaxAge","externalID":"s:16VernissageServer6MaxAgeO","navigatorTitle":[{"text":"MaxAge","kind":"identifier"}],"symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaxAge"}],"modules":[{"name":"Vernissage"}]},"seeAlsoSections":[{"title":"System & Database Models","generated":true,"anchor":"System--Database-Models","identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/AccessTokens","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ApplicationSettings","doc:\/\/VernissageServer\/documentation\/VernissageServer\/Article","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfo","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleMarker","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleRead","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleVisibility","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleVisibilityType","doc:\/\/VernissageServer\/documentation\/VernissageServer\/Archive","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArchiveStatus","doc:\/\/VernissageServer\/documentation\/VernissageServer\/Attachment","doc:\/\/VernissageServer\/documentation\/VernissageServer\/AttachmentHistory","doc:\/\/VernissageServer\/documentation\/VernissageServer\/AuthClient","doc:\/\/VernissageServer\/documentation\/VernissageServer\/AuthDynamicClient","doc:\/\/VernissageServer\/documentation\/VernissageServer\/AuthClientType"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"MaxAge"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"public"},{"type":"text","text":" directive is included in a server’s HTTP response to indicate that it can be stored in a shared cache."},{"type":"text","text":" "},{"type":"text","text":"Caches are not permitted to store HTTP responses that contain the HTTP Authorization header unless they are accompanied by the public directive."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"max-age"},{"type":"text","text":" directive is sent by a server to indicate that the HTTP response will remain fresh for a specified number of seconds after it is generated."},{"type":"text","text":" "},{"type":"text","text":"Essentially, it informs caches how long it will remain fresh. Importantly, the number of seconds indicates the period from which the content was generated,"},{"type":"text","text":" "},{"type":"text","text":"as opposed to received. This means that any time spent in transit or stored in the caches of intermediaries is deducted from the allowance."}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"immutable","type":"codeVoice"},{"text":" directive indicates a guarantee by the server that the HTTP response will not be updated while it is still fresh.","type":"text"},{"text":" ","type":"text"},{"text":"This can be used to avoid unnecessary conditional HTTP requests","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge"},"abstract":[{"type":"text","text":"Max-Age cache setting for static centent served by S3 CDN: https:\/\/http.dev\/cache-control."}],"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/VernissageServer\/s15BitwiseCopyableP","doc:\/\/VernissageServer\/Se","doc:\/\/VernissageServer\/SE","doc:\/\/VernissageServer\/SQ","doc:\/\