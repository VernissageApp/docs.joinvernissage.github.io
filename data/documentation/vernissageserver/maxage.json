horization header unless they are accompanied by the public directive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"max-age"},{"text":" directive is sent by a server to indicate that the HTTP response will remain fresh for a specified number of seconds after it is generated.","type":"text"},{"text":" ","type":"text"},{"text":"Essentially, it informs caches how long it will remain fresh. Importantly, the number of seconds indicates the period from which the content was generated,","type":"text"},{"text":" ","type":"text"},{"text":"as opposed to received. This means that any time spent in transit or stored in the caches of intermediaries is deducted from the allowance.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"immutable"},{"text":" directive indicates a guarantee by the server that the HTTP response will not be updated while it is still fresh.","type":"text"},{"text":" ","type":"text"},{"text":"This can be used to avoid unnecessary conditional HTTP requests","type":"text"}]}]}],"references":{"doc://VernissageServer/documentation/VernissageServer/AuthClient":{"type":"topic","title":"AuthClient","abstract":[{"type":"text","text":"OAuth client data."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"AuthClient","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AuthClient","kind":"identifier"}],"url":"\/documentation\/vernissageserver\/authclient","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/AuthClient"},"doc://VernissageServer/documentation/VernissageServer/Archive":{"navigatorTitle":[{"text":"Archive","kind":"identifier"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Archive","kind":"identifier"}],"abstract":[{"text":"Archive requested by user.","type":"text"}],"url":"\/documentation\/ver