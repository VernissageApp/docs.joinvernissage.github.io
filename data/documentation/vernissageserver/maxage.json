{"sections":[],"metadata":{"symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaxAge","kind":"identifier"}],"navigatorTitle":[{"text":"MaxAge","kind":"identifier"}],"modules":[{"name":"Vernissage"}],"title":"MaxAge","roleHeading":"Enumeration","externalID":"s:16VernissageServer6MaxAgeO","role":"symbol"},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/day","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/month","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/week","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/year"],"title":"Enumeration Cases"},{"title":"Initializers","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/init(rawValue:)"],"anchor":"Initializers"},{"title":"Default Implementations","generated":true,"identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/Equatable-Implementations","doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge\/RawRepresentable-Implementations"],"anchor":"Default-Implementations"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MaxAge","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"public"},{"type":"text","text":" directive is included in a server’s HTTP response to indicate that it can be stored in a shared cache."},{"type":"text","text":" "},{"type":"text","text":"Caches are not permitted to store HTTP responses that contain the HTTP Authorization header unless they are accompanied by the public directive."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"max-age"},{"type":"text","text":" directive is sent by a server to indicate that the HTTP response will remain fresh for a specified number of seconds after it is generated."},{"type":"text","text":" "},{"type":"text","text":"Essentially, it informs caches how long it will remain fresh. Importantly, the number of seconds indicates the period from which the content was generated,"},{"type":"text","text":" "},{"type":"text","text":"as opposed to received. This means that any time spent in transit or stored in the caches of intermediaries is deducted from the allowance."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"immutable"},{"type":"text","text":" directive indicates a guarantee by the server that the HTTP response will not be updated while it is still fresh."},{"type":"text","text":" "},{"type":"text","text":"This can be used to avoid unnecessary conditional HTTP requests"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/VernissageServer\/s15BitwiseCopyableP","doc:\/\/VernissageServer\/Se","doc:\/\/VernissageServer\/SE","doc:\/\/VernissageServer\/SQ","doc:\/\/VernissageServer\/SH","doc:\/\/VernissageServer\/SY","doc:\/\/VernissageServer\/s8SendableP","doc:\/\/VernissageServer\/s16SendableMetatypeP"],"title":"Conforms To"}],"variants":[{"paths":["\/documentation\/vernissageserver\/maxage"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/MaxAge"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"abstract":[{"type":"text","text":"Max-Age cache setting for static centent served by S3 CDN: https:\/\/http.dev\/cache-control."}],"seeAlsoSections":[{"title":"System & Database Models","generated":tr