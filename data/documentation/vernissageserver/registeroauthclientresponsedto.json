word","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"jwks"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Client’s JSON Web Key Set [RFC7517] document value, which contains"},{"type":"text","text":" "},{"type":"text","text":"the client’s public keys.  The value of this field MUST be a JSON"},{"type":"text","text":" "},{"type":"text","text":"object containing a valid JWK Set.  These keys can be used by"},{"type":"text","text":" "},{"type":"text","text":"higher-level protocols that use signing or encryption.  This"},{"type":"text","text":" "},{"type":"text","text":"parameter is intended to be used by clients that cannot use the"},{"type":"text","text":" "},{"type":"text","text":"“jwks_uri” parameter, such as native clients that cannot host"},{"type":"text","text":" "},{"type":"text","text":"public URLs.  The “jwks_uri” and “jwks” parameters MUST NOT both"},{"type":"text","text":" "},{"type":"text","text":"be present in the same request or response."}]},"doc://VernissageServer/documentation/VernissageServer/ArticleFileInfoDto":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ArticleFileInfoDto"}],"navigatorTitle":[{"kind":"identifier","text":"ArticleFileInfoDto"}],"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticleFileInfoDto","role":"symbol","url":"\/documentation\/vernissageserver\/articlefileinfodto","title":"ArticleFileInfoDto"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubFollowRespondDto":{"title":"ActivityPubFollowRespondDto","url":"\/documentation\/vernissageserver\/activitypubfollowresponddto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubFollowRespondDto","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"ActivityPubFollowRespondDto","kind":"identifier"}],"abstract":[],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ActivityPubFollowRespondDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer":{"abstract":[{"text":"Vernissage is a photo-sharing platform built for photographers, designed to seamlessly exchange content across","type":"text"},{"type":"text","text":" "},{"text":"the fediverse - offering powerful features you won’t find anywhere else.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/vernissageserver","navigatorTitle":[{"kind":"text","text":"Vernissage"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer","title":"Vernissage","kind":"symbol"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/jwksUri":{"role":"symbol","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientResponseDto\/jwksUri","title":"jwksUri","url":"\/documentation\/vernissageserver\/registeroauthclientresponsedto\/jwksuri","kind":"symbol","abstract":[{"text":"URL string referencing the client’s JSON Web Key (JWK) Set","type":"text"},{"text":" ","type":"text"},{"text":"[RFC7517] document, which contains the client’s public keys.  The","type":"text"},{"text":" ","type":"text"},{"text":"value of this field MUST point to a valid JWK Set document.  These","type":"text"},{"text":" ","type":"text"},{"text":"keys can be used by higher-level protocols that use signing or","type":"text"},{"text":" ","type":"text"},{"text":"encryption.  For instance, these keys might be used by some","type":"text"},{"text":" ","type":"text"},{"text":"applications for validating signed requests made to the token","type":"text"},{"type":"text","text":" "},{"type":"text","text":"endpoint when using JWTs for client authentication [RFC7523].  Use"},{"type":"text","text":" "},{"type":"text","text":"of this parameter is preferred over the “jwks” parameter, as it"},{"type":"text","text":" "},{"type":"text","text":"allows for easier key rotation.  The “jwks_uri” and “jwks”"},{"type":"text","text":" "},{"type":"text","text":"parameters MUST NOT both be present in the same request or"},{"type":"text","text":" "},{"text":"response.","type":"text"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"jwksUri"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?"}],"type":"topic"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/clientName":{"title":"clientName","type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientresponsedto\/clientname","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientResponseDto\/clientName","abstract":[{"text":"Human-readable string name of the client to be presented to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"end-user during authorization.  If omitted, the authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY display the raw “client_id” value to the end-user"},{"type":"text","text":" "},{"text":"instead.  It is RECOMMENDED that clients always send this field.","type":"text"},{"text":" ","type":"text"},{"text":"The value of this field MAY be internationalized, as described in","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Section 2.2."}],"kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clientName","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"?","kind":"text"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/responseTypes":{"role":"symbol","title":"responseTypes","type":"topic","identifier":"doc:\/\/VernissageServer\/documentati