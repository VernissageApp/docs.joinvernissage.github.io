/5Vapor22AsyncResponseEncodableP":{"title":"Vapor.AsyncResponseEncodable","type":"unresolvable","identifier":"doc:\/\/VernissageServer\/5Vapor22AsyncResponseEncodableP"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/scope":{"title":"scope","url":"\/documentation\/vernissageserver\/registeroauthclientresponsedto\/scope","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientResponseDto\/scope","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"scope","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?","kind":"text"}],"abstract":[{"type":"text","text":"String containing a space-separated list of scope values (as"},{"type":"text","text":" "},{"type":"text","text":"described in Section 3.3 of OAuth 2.0 [RFC6749]) that the client"},{"type":"text","text":" "},{"type":"text","text":"can use when requesting access tokens.  The semantics of values in"},{"type":"text","text":" "},{"type":"text","text":"this list are service specific.  If omitted, an authorization"},{"type":"text","text":" "},{"type":"text","text":"server MAY register a client with a default set of scopes."}]},"doc://VernissageServer/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/VernissageServer\/s16SendableMetatypeP"},"doc://VernissageServer/documentation/VernissageServer/ArticlesCountDto":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ArticlesCountDto","kind":"identifier"}],"navigatorTitle":[{"text":"ArticlesCountDto","kind":"identifier"}],"type":"topic","abstract":[],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ArticlesCountDto","kind":"symbol","role":"symbol","url":"\/documentation\/vernissageserver\/articlescountdto","title":"ArticlesCountDto"},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/clientId":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"clientId"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"}],"type":"topic","kind":"symbol","abstract":[{"text":"REQUIRED.  OAuth 2.0 client identifier string.  It SHOULD NOT be","type":"text"},{"text":" ","type":"text"},{"text":"currently valid for any other registered client, though an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"authorization server MAY issue the same client identifier to"},{"type":"text","text":" "},{"text":"multiple instances of a registered client at its discretion.","type":"text"}],"identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientResponseDto\/clientId","role":"symbol","url":"\/documentation\/vernissageserver\/registeroauthclientresponsedto\/clientid","title":"clientId"},"doc://VernissageServer/documentation/VernissageServer/ActivityPubRequestPath":{"title":"ActivityPubRequestPath","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestPath","url":"\/documentation\/vernissageserver\/activitypubrequestpath","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ActivityPubRequestPath"}],"abstract":[],"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActivityPubRequestPath"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/clientSecret":{"title":"clientSecret","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientResponseDto\/clientSecret","url":"\/documentation\/vernissageserver\/registeroauthclientresponsedto\/clientsecret","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"OPTIONAL.  OAuth 2.0 client secret string.  If issued, this MUST"},{"type":"text","text":" "},{"type":"text","text":"be unique for each “client_id” and SHOULD be unique for multiple"},{"type":"text","text":" "},{"type":"text","text":"instances of a client using the same “client_id”.  This value is"},{"type":"text","text":" "},{"text":"used by confidential clients to authenticate to the token","type":"text"},{"text":" ","type":"text"},{"text":"endpoint, as described in OAuth 2.0 [RFC6749], Section 2.3.1.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"clientSecret"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/softwareVersion":{"title":"softwareVersion","type":"topic","url":"\/documentation\/vernissageserver\/registeroauthclientresponsedto\/softwareversion","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/RegisterOAuthClientResponseDto\/softwareVersion","abstract":[{"type":"text","text":"A version identifier string for the client software identified by"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of the “software_version” SHOULD change"},{"type":"text","text":" "},{"type":"text","text":"on any update to the client software identified by the same"},{"type":"text","text":" "},{"type":"text","text":"“software_id”.  The value of this field is intended to be compared"},{"type":"text","text":" "},{"type":"text","text":"using string equality matching and no other comparison semantics"},{"type":"text","text":" "},{"type":"text","text":"are defined by this specification.  The value of this field is"},{"type":"text","text":" "},{"type":"text","text":"outside the scope of this specification, but it is not intended to"},{"type":"text","text":" "},{"type":"text","text":"be human readable and is usually opaque to the client and"},{"type":"text","text":" "},{"type":"text","text":"authorization server.  The definition of what constitutes an"},{"type":"text","text":" "},{"type":"text","text":"update to client software that would trigger a change to this"},{"type":"text","text":" "},{"type":"text","text":"value is specific to the software itself and is outside the scope"},{"type":"text","text":" "},{"type":"text","text":"of this specification."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"softwareVersion"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?"}]},"doc://VernissageServer/documentation/VernissageServer/ActivityPubProfileUpdateJobDto":{"title":"ActivityPubProfileUpdateJobDto","type":"topic","url":"\/documentation\/vernissageserver\/activitypubprofileupdatejobdto","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubProfileUpdateJobDto","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ActivityPubProfileUpdateJobDto"}],"navigatorTitle":[{"text":"ActivityPubProfileUpdateJobDto","kind":"identifier"}]},"doc://VernissageServer/documentation/VernissageServer/ActivityPubRequestMethod":{"title":"ActivityPubRequestMethod","type":"topic","url":"\/documentation\/vernissageserver\/activitypubrequestmethod","identifier":"doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPubRequestMethod","abstract":[],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"ActivityPubRequestMethod"}],"navigatorTitle":[{"kind":"identifier","text":"ActivityPubRequestMethod"}]},"doc://VernissageServer/documentation/VernissageServer/RegisterOAuthClientResponseDto/redirectUris":{"title":"redirectUris","identifier":"doc:\/\/VernissageServer\/documenta