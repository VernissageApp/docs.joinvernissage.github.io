{"abstract":[{"type":"text","text":"Application which is main API component for Vernissage photos sharing platform."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"Host Vernissage Server (API)","images":[{"type":"card","identifier":"host-server-card.jpg"}],"modules":[{"name":"Vernissage"}],"role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/VernissageServer\/documentation\/VernissageServer"]]},"kind":"article","seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/VernissageServer\/documentation\/VernissageServer\/HostVernissageWeb","doc:\/\/VernissageServer\/documentation\/VernissageServer\/DockerContainers","doc:\/\/VernissageServer\/documentation\/VernissageServer\/BuildDocumentation","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ActivityPub","doc:\/\/VernissageServer\/documentation\/VernissageServer\/OAuthClientAutorization","doc:\/\/VernissageServer\/documentation\/VernissageServer\/WebFinger","doc:\/\/VernissageServer\/documentation\/VernissageServer\/HttpSecurity","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ContentFeeds","doc:\/\/VernissageServer\/documentation\/VernissageServer\/ColorProfiles"],"anchor":"Essentials","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"inlineContent":[{"text":"Vernissage API server is created in ","type":"text"},{"type":"reference","identifier":"https:\/\/www.swift.org\/","isActive":true},{"text":" language with ","type":"text"},{"type":"reference","identifier":"https:\/\/vapor.codes","isActive":true},{"text":" framework.","type":"text"},{"text":" ","type":"text"},{"text":"We can run it in all operating systems supporting ","type":"text"},{"type":"codeVoice","code":"Swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"Vapor"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Prerequisites","anchor":"Prerequisites","