ode":"dbConnectTimeoutSeconds"},{"type":"text","text":" - maximum number of seconds to wait for opening a new PostgreSQL TCP connection (default: "},{"type":"codeVoice","code":"10"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"queueUrl"},{"type":"text","text":" - URL to Redis in memory data store (used as cache and queue by Vernissage)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"s3*"},{"type":"text","text":" - configuration of S3 storage. Here you can use any external S3 compatible cloud storage or "},{"identifier":"https:\/\/min.io","type":"reference","isActive":true},{"type":"text","text":" docker ("},{"identifier":"https:\/\/hub.docker.com\/r\/minio\/minio","type":"reference","isActive":true},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"disableQueueJobs"},{"type":"text","text":" - enables or disables Redis queues. Possible values are “true” and “false”,"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"disableScheduledJobs"},{"type":"text","text":" - enables or disables background schedulers. Possible values are “true” and “false”."}]}]}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If the "},{"type":"codeVoice","code":"s3Region"},{"type":"text","text":" variable is set, it causes the other settings to be overwritten and use Amazon AWS S3."}]}],"style":"note"},{"inlineContent":[{"text":"In production environment you can override configuration parameters by environment variables. For example if you want to set custom ","type":"text"},{"type":"codeVoice","code":"baseAddress"},{"text":" you have to define variable: ","type":"text"},{"type":"codeVoice","code":"VERNISSAGE_BASEADDRESS"},{"text":", etc.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Log level","anchor":"Log-level","level":2},{"inlineCont